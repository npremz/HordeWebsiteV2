# Port du serveur (par defaut: 4328)
# Staging: 4328
# Production: 4329 (ou autre)
PORT=4328

# Nom du container Docker (par defaut: hordenew)
# Staging: horde-staging
# Production: horde-prod
CONTAINER_NAME=hordenew

# Environnement du site
# Staging: "staging"
# Production: "production"
SITE_ENV=

# Afficher les brouillons et articles futurs pendant le build du staging.
# Staging: 1
# Production: 0 (un build SITE_ENV=production refuse la valeur 1)
BLOG_PREVIEW_UNPUBLISHED=0

# API Resend pour les emails
RESEND_API_KEY=
CONTACT_EMAIL_FROM=Horde Website <noreply@hordeagence.com>
CONTACT_EMAIL_TO=hello@hordeagence.com
