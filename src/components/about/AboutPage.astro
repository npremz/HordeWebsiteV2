---
/**
 * Page « L’agence » (maquette « Squad ») : hero clair sous un globe filaire, bandeau
 * « About us », photos sur fond noir avec le titre en filigrane, la vitesse d'itération (schéma
 * IA), le carousel des services, puis Bruxelles (carte BXL et boussole).
 *
 * Largeur : au-delà de la maquette (1512px), le contenu reste groupé au centre, comme sur la
 * page prix (globe, hero, photos, filigrane plafonnés).
 */
import { Image } from "astro:assets";
import type { Locale } from "../../i18n";
import teamPhoto from "../../assets/images/nous-opti.jpg";
import deskPhoto from "../../assets/images/keyboard_a.jpg";
import HomeMarquee from "../home/ui/HomeMarquee.astro";
import AboutCompass from "./AboutCompass.astro";
import AboutGlobe from "./AboutGlobe.astro";
import AboutMapCard from "./AboutMapCard.astro";
import AboutServices from "./AboutServices.astro";
import { getAboutCopy } from "./copy";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getAboutCopy(lang);
const contactHref = `/${lang}/contact/`;
// Assez de « About · Us » pour couvrir les écrans larges (le bandeau répète la liste 3 fois).
const marquee = Array.from({ length: 6 }, () => copy.marquee).flat();
const diagramLines = [23, 35, 47.5, 59.5, 71.5];
---

<!-- 1. Hero : la phrase-manifeste sous le haut du globe. -->
<section class="ab-hero" data-header-theme="light">
  <div class="ab-hero__sky" aria-hidden="true">
    <AboutGlobe class="ab-globe ab-hero__globe" />
    <span class="ab-star ab-star--top">*</span>
    <span class="ab-star ab-star--left">*</span>
    <span class="ab-star ab-star--right">*</span>
  </div>

  <div class="ab-hero__content">
    <h1 class="ab-hero__title"><span class="ab-hero__brand">{copy.hero.titleBrand}</span>{copy.hero.titleRest}</h1>
    <p class="ab-hero__text ab-hero__text--statement">{copy.hero.statement}</p>
    <p class="ab-hero__text ab-hero__text--offer">{copy.hero.offer}</p>
  </div>
</section>

<!-- 2. Bandeau puis photos sur fond noir, titre de la page en filigrane. -->
<section class="ab-photos" data-header-theme="dark">
  <HomeMarquee items={marquee} variant="dark" followScroll class="ab-photos__marquee" />
  <p class="ab-ghost" aria-hidden="true" style={`--ghost-scale-m: ${copy.ghostScale.mobile}; --ghost-scale: ${copy.ghostScale.desktop}`}>{copy.ghost}</p>
  <div class="ab-photos__grid">
    <figure class="ab-photo ab-photo--team">
      <Image
        src={teamPhoto}
        alt={copy.photos.teamAlt}
        widths={[400, 560, 820, 1112]}
        sizes="(min-width: 1024px) 556px, 51vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="sr-only">{copy.photos.teamCaption}</figcaption>
    </figure>
    <div class="ab-photo ab-photo--desk">
      <Image
        src={deskPhoto}
        alt={copy.photos.deskAlt}
        widths={[320, 432, 595]}
        sizes="(min-width: 1024px) 432px, 49vw"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
  <div class="ab-photos__dots" aria-hidden="true"><i></i><i></i><i></i></div>
</section>

<!-- 3. La vitesse d'itération, au service de l'expérience (bas du globe). -->
<section class="ab-speed" data-header-theme="light">
  <AboutGlobe class="ab-globe ab-speed__globe" />

  <div class="ab-speed__head">
    <span class="ab-speed__paren" aria-hidden="true">(</span>
    <h2 class="ab-speed__title" data-home-reveal>{copy.speed.title}</h2>
    <span class="ab-speed__paren" aria-hidden="true">)</span>
  </div>

  <figure class="ab-diagram" role="img" aria-label={`${copy.speed.diagram.input} → ${copy.speed.diagram.core} → ${copy.speed.diagram.output}`}>
    <span class="ab-diagram__label ab-diagram__label--in" aria-hidden="true">{copy.speed.diagram.input}</span>
    <svg class="ab-diagram__graphic" viewBox="0 0 369 95" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="ab-diagram-gradient" x1="0" y1="0.2" x2="1" y2="0.8">
          <stop offset="0" stop-color="#ffd36f" />
          <stop offset="0.42" stop-color="#f3de5b" />
          <stop offset="0.62" stop-color="#cbdb5d" />
          <stop offset="1" stop-color="#5fce55" />
        </linearGradient>
      </defs>
      <rect x="26.5" width="313.5" height="95" rx="20" fill="url(#ab-diagram-gradient)" />
      <g stroke="#000" stroke-width="1">
        {diagramLines.map((y) =>
          y === 47.5 ? (
            <path d="M0 47.5H147.5" vector-effect="non-scaling-stroke" />
          ) : (
            <path d={`M0 ${y}H72.5C105 ${y} 115 47.5 147.5 47.5`} vector-effect="non-scaling-stroke" />
          ),
        )}
        <circle cx="184.5" cy="47.5" r="24.5" vector-effect="non-scaling-stroke" />
        <path d="M222.5 47.5H368.5" vector-effect="non-scaling-stroke" />
      </g>
      <circle cx="184.5" cy="47.5" r="17" stroke="#000" stroke-width="4" />
      <text x="184.5" y="47.5" class="ab-diagram__core">{copy.speed.diagram.core}</text>
    </svg>
    <span class="ab-diagram__label ab-diagram__label--out" aria-hidden="true">{copy.speed.diagram.output}</span>
  </figure>

  <div class="ab-speed__texts home-column">
    <p class="ab-text" data-home-reveal>{copy.speed.team}</p>
    <p class="ab-text" data-home-reveal style="--reveal-delay: 0.1s">{copy.speed.modes}</p>
  </div>
</section>

<!-- 4. Les services, en carousel. -->
<AboutServices lang={lang} />

<!-- 5. Bruxelles et remote : texte, contact, carte BXL et boussole. -->
<section class="ab-work" data-header-theme="light">
  <div class="ab-work__intro home-column">
    <div class="ab-work__heading">
      <h2 class="ab-work__title">
        {copy.work.titleLines.map((line, index) => (
          <>{index > 0 && " "}<span class="block">{line}</span></>
        ))}
      </h2>
      <p class="ab-work__where">
        <span>{copy.work.based[0]}<br />{copy.work.based[1]}</span>
        <span>{copy.work.remote}</span>
      </p>
    </div>
    <svg class="ab-target" viewBox="0 0 36 36" fill="none" aria-hidden="true">
      <circle cx="18" cy="18" r="17.25" stroke="currentColor" stroke-width="1.5" />
      <circle cx="18" cy="18" r="10.5" stroke="currentColor" stroke-width="4" />
      <circle cx="18" cy="18" r="4.5" fill="currentColor" />
    </svg>
    <p class="ab-text ab-work__text">{copy.work.text}</p>
    <a href={contactHref} class="ab-work__cta">{copy.work.cta}</a>
  </div>

  <hr class="ab-work__rule" />

  <div class="ab-work__places home-column">
    <AboutMapCard lang={lang} class="ab-work__map" />
    <figure class="ab-compass">
      <span class="ab-compass__dial" aria-hidden="true"><AboutCompass labels={copy.map.compassLabels} /></span>
      <figcaption class="ab-compass__caption">{copy.map.compass[0]}<br />{copy.map.compass[1]}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* ---------- Partagé ---------- */

  .ab-hero :global(.ab-globe),
  .ab-speed :global(.ab-globe) {
    position: absolute;
    left: 50%;
    width: var(--globe);
    height: auto;
    color: #908f98;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ab-text {
    max-width: 21.75rem;
    font-size: 0.8125rem;
    line-height: 1.08;
    letter-spacing: -0.005em;
  }

  /* ---------- 1. Hero ---------- */

  .ab-hero {
    /* Globe : 802px de diamètre à 375px, 1534px à 1512px (maquettes), plafonné au-delà. */
    --globe: min(calc(35rem + 64.4vw), 95.875rem);
    --apex: 11.25rem;
    --inset: 0.5rem;
    position: relative;
    overflow: hidden;
    padding: calc(var(--apex) + 4.25rem) var(--inset) 1rem;
    background: var(--color-bg);
    color: var(--color-black);
  }

  .ab-hero__sky {
    position: absolute;
    inset: 0;
  }

  .ab-hero :global(.ab-hero__globe) {
    top: var(--apex);
  }

  .ab-star {
    position: absolute;
    font-size: 4.25rem;
    font-weight: 400;
    line-height: 0;
    transform: translate(-50%, 0.36em);
  }

  .ab-star--top {
    top: calc(var(--apex) - 2.15rem);
    left: 50%;
  }

  .ab-star--left,
  .ab-star--right {
    top: calc(var(--apex) + 0.3rem);
    left: 5.1%;
  }

  .ab-star--right {
    left: 94.9%;
  }

  .ab-hero__content {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 2.4rem 0.75rem;
  }

  .ab-hero__title {
    grid-column: 1 / -1;
    max-width: 22.5rem;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 0.97;
    letter-spacing: -0.035em;
  }

  .ab-hero__brand {
    color: #7a7980;
  }

  .ab-hero__text {
    font-size: 0.8125rem;
    line-height: 1.08;
  }

  /* Mobile : le constat à droite, un peu plus bas ; la réponse à gauche. */
  .ab-hero__text--statement {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.85rem;
  }

  .ab-hero__text--offer {
    grid-column: 1;
    grid-row: 2;
  }

  /* ---------- 2. Photos ---------- */

  .ab-photos {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: 0;
    background: #16191b;
  }

  .ab-photos :global(.ab-photos__marquee) {
    position: relative;
    z-index: 2;
  }

  .ab-photos__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: start;
    gap: 0.375rem;
    width: calc(100% - 1rem);
    max-width: 62.75rem;
    margin: 0.75rem auto 0;
  }

  .ab-photo {
    overflow: hidden;
    border-radius: 0.5rem;
    background: #24272a;
  }

  .ab-photo--team {
    aspect-ratio: 556 / 770;
  }

  .ab-photo--desk {
    aspect-ratio: 432 / 542;
  }

  .ab-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Titre en filigrane : sous les photos (mobile), derrière elles (desktop). */
  .ab-ghost {
    order: 2;
    margin-top: 4.5rem;
    /* Sous les photos sur mobile : le mot entier tient dans l'écran. */
    font-size: calc(23.5vw * var(--ghost-scale-m, 1));
    /* L'interlettrage négatif fait déborder la dernière lettre de la boîte, et background-clip:
       text ne peint que dans la boîte : la marge latérale évite de couper le « e ». */
    padding-inline: 0.15em;
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-align: center;
    white-space: nowrap;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.075), rgb(255 255 255 / 0) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    pointer-events: none;
    user-select: none;
  }

  .ab-photos__dots {
    order: 3;
    position: relative;
    height: 2rem;
    margin-top: -2.4rem;
  }

  .ab-photos__dots i {
    position: absolute;
    top: 0;
    width: 4px;
    height: 4px;
    background: var(--color-white);
  }

  .ab-photos__dots i:nth-child(1) {
    left: 0.6rem;
  }

  .ab-photos__dots i:nth-child(2) {
    top: 1.6rem;
    left: calc(50% - 2px);
  }

  .ab-photos__dots i:nth-child(3) {
    right: 0.6rem;
  }

  /* ---------- 3. Vitesse ---------- */

  .ab-speed {
    --globe: min(calc(35rem + 64.4vw), 95.875rem);
    position: relative;
    overflow: hidden;
    padding-block: 2.6rem 2.6rem;
    background: var(--color-bg);
    color: var(--color-black);
  }

  /* Bas du globe, pôle sud à 252px du haut de la section : caché sur mobile (maquette). */
  .ab-speed :global(.ab-speed__globe) {
    display: none;
    top: calc(15.75rem - var(--globe));
  }

  .ab-speed__head {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 62.5rem) auto;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-inline: 0.5rem;
  }

  .ab-speed__title {
    font-size: 1.4375rem;
    font-weight: 400;
    line-height: 1.13;
    letter-spacing: -0.03em;
    text-align: center;
  }

  .ab-speed__paren {
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1;
  }

  /* Schéma : libellés au-dessus et au-dessous sur mobile, de part et d'autre sur desktop. */
  .ab-diagram {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.4rem;
    margin-top: 4.25rem;
  }

  .ab-diagram__graphic {
    display: block;
    width: min(68vw, 16rem);
    height: auto;
    overflow: visible;
  }

  .ab-diagram__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ab-diagram__core {
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-anchor: middle;
    dominant-baseline: central;
    fill: #000;
  }

  .ab-speed__texts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 0.75rem;
    margin-top: 5.75rem;
  }

  .ab-speed__texts > :last-child {
    margin-top: 0.85rem;
  }

  /* ---------- 5. Bruxelles ---------- */

  .ab-work {
    position: relative;
    padding-block: 1.9rem 3.5rem;
    background: var(--color-bg);
    color: var(--color-black);
  }

  .ab-work__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 2.75rem 1rem;
  }

  .ab-work__heading {
    width: fit-content;
    max-width: 100%;
  }

  .ab-work__title {
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .ab-work__where {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 1.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Mobile : le label « / Remote » va jusqu'au bord droit, sous la cible. */
  .ab-work__heading {
    grid-column: 1 / -1;
    grid-row: 1;
    width: auto;
  }

  .ab-target {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    width: 1.125rem;
    margin-top: 0.25rem;
  }

  .ab-work__text {
    align-self: center;
    max-width: 11rem;
  }

  .ab-work__cta {
    display: inline-flex;
    align-items: center;
    align-self: center;
    justify-content: center;
    height: 2rem;
    padding-inline: 0.9rem;
    border-radius: 0.5rem;
    background: var(--color-button-white);
    font-size: 0.9375rem;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .ab-work__cta:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .ab-work__cta:hover {
      background: var(--color-black);
      color: var(--color-white);
    }
  }

  .ab-work__rule {
    margin: 1.9rem 0 0;
    border: 0;
    border-top: 1px solid #16191b;
  }

  /* Mobile : boussole d'abord, puis la carte BXL. */
  .ab-work__places {
    display: flex;
    flex-direction: column-reverse;
    gap: 2.6rem;
    margin-top: 2rem;
  }

  .ab-work__places :global(.ab-work__map) {
    width: 100%;
    max-width: 30.0625rem;
    margin-inline: auto;
  }

  .ab-compass {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.75rem;
  }

  .ab-compass__dial {
    display: block;
    width: min(69vw, 22.25rem);
    color: #16191b;
  }

  .ab-compass__dial :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .ab-compass__caption {
    max-width: 17rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  /* ---------- Tablette ---------- */

  @media (min-width: 640px) {
    .ab-hero {
      --apex: 12rem;
      --inset: 2rem;
      padding-top: calc(var(--apex) + 6rem);
      padding-bottom: 2rem;
    }

    .ab-star--left {
      left: 8%;
    }

    .ab-star--right {
      left: 92%;
    }

    .ab-hero__title {
      font-size: 1.75rem;
    }

    .ab-hero__text,
    .ab-text {
      font-size: 1rem;
      line-height: 1.07;
    }

    .ab-photos__grid {
      grid-template-columns: 556fr 432fr;
      gap: 0.75rem;
      width: calc(100% - 4rem);
      margin-top: 1rem;
    }

    .ab-photo {
      border-radius: 0.875rem;
    }

    .ab-speed {
      padding-block: 6rem 3rem;
    }

    .ab-speed :global(.ab-speed__globe) {
      display: block;
    }

    .ab-speed__title {
      font-size: 2.25rem;
      line-height: 1.08;
    }

    .ab-speed__paren {
      font-size: 3rem;
    }

    .ab-speed__texts {
      grid-template-columns: repeat(2, minmax(0, 21.75rem));
      justify-content: space-between;
    }

    .ab-speed__texts > :last-child {
      margin-top: 0;
    }

    .ab-work {
      padding-block: 6rem 4rem;
    }

    .ab-work__heading {
      grid-column: 1;
      width: fit-content;
    }

    .ab-work__title {
      font-size: 2.5rem;
    }

    .ab-target {
      width: 2.25rem;
      margin-top: 0.4rem;
    }

    .ab-work__text {
      max-width: 21.75rem;
    }

    .ab-work__cta {
      height: 3.5625rem;
      padding-inline: 2rem;
      border-radius: 1rem;
      font-size: 1.125rem;
    }

    .ab-work__rule {
      margin-top: 2.9rem;
    }
  }

  /* ---------- Desktop ---------- */

  @media (min-width: 1024px) {
    /* Hero : titre et deux textes alignés en bas, sur la largeur de la maquette au plus. */
    .ab-hero {
      --apex: 17.6875rem;
      --inset: max(2rem, calc((100% - 90.5rem) / 2));
      height: 36.25rem;
      padding: 0 var(--inset);
    }

    .ab-star--top {
      top: calc(var(--apex) - 2.5rem);
    }

    .ab-star--left,
    .ab-star--right {
      top: calc(var(--apex) + 6.4rem);
      left: calc(50% - min(30.4vw, 28.75rem));
    }

    .ab-star--right {
      left: calc(50% + min(30.4vw, 28.75rem));
    }

    .ab-hero__content {
      position: absolute;
      right: var(--inset);
      bottom: 2.15rem;
      left: var(--inset);
      grid-template-columns: 29.85% 30.95% minmax(0, 1fr);
      align-items: end;
      gap: 0;
    }

    /* Marge à droite des deux premières colonnes : sans effet à 1512px, évite que les textes
       se touchent sur les petits desktops. */
    .ab-hero__title,
    .ab-hero__text--statement {
      padding-right: 1.5rem;
    }

    .ab-hero__title {
      grid-column: 1;
      max-width: 24rem;
      font-size: 2.0625rem;
      line-height: 0.92;
    }

    .ab-hero__text {
      max-width: 21.6rem;
      margin: 0 0 0.05rem;
      font-size: 1.0625rem;
      line-height: 1.02;
    }

    .ab-hero__text--statement {
      grid-column: 2;
      grid-row: 1;
      max-width: 23.1rem;
    }

    .ab-hero__text--offer {
      grid-column: 3;
      grid-row: 1;
    }

    /* Photos centrées ; filigrane derrière, qui déborde des deux côtés. */
    .ab-photos {
      display: block;
      padding-bottom: 10.6rem;
    }

    .ab-photos__grid {
      width: min(calc(100% - 2 * var(--home-gutter, 7.25rem)), 62.75rem);
      gap: 1rem;
    }

    .ab-ghost {
      position: absolute;
      top: 7.15rem;
      left: 50%;
      margin: 0;
      font-size: calc(min(24.6vw, 23.25rem) * var(--ghost-scale, 1));
      font-weight: 300;
      letter-spacing: -0.09em;
      transform: translateX(-50%);
    }

    .ab-photos__dots {
      display: none;
    }

    /* Vitesse : bas du globe, titre entre parenthèses, schéma et deux textes. */
    .ab-speed {
      padding-block: 5.4rem 2.9rem;
    }

    .ab-speed__head {
      gap: 4.8rem;
    }

    .ab-speed__title {
      max-width: 63rem;
      font-size: 3.6875rem;
      line-height: 0.97;
    }

    .ab-speed__paren {
      font-size: 3.75rem;
    }

    .ab-diagram {
      flex-direction: row;
      justify-content: center;
      gap: 1.55rem;
      margin-top: 6.1rem;
    }

    .ab-diagram__graphic {
      width: 23.0625rem;
    }

