---
/**
 * Illustration d'une carte service : cercles, intersections en losanges, chiffres, et 8 repères
 * autour (carrés aux points cardinaux, losanges en diagonale). Couvre toute la carte (même
 * repère que la maquette : 460 × 620, centre au milieu).
 */
import { intersections, type ServiceArt } from "./serviceArt";

interface Props {
  art: ServiceArt;
}

const { art } = Astro.props;
const ring = 213.5;
const diagonal = Math.round((ring / Math.SQRT2) * 100) / 100;
const markers = [
  [0, -ring, 0],
  [diagonal, -diagonal, 45],
  [ring, 0, 0],
  [diagonal, diagonal, 45],
  [0, ring, 0],
  [-diagonal, diagonal, 45],
  [-ring, 0, 0],
  [-diagonal, -diagonal, 45],
] as const;
const points = intersections(art.circles, art.r);
---

<svg class="about-art" viewBox="-230 -310 460 620" fill="none" aria-hidden="true" style={`color: ${art.color}`}>
  <g class="about-art__markers" fill="currentColor">
    {markers.map(([x, y, angle]) => (
      <rect x="-2.5" y="-2.5" width="5" height="5" transform={`translate(${x} ${y}) rotate(${angle})`} />
    ))}
  </g>
  <g class="about-art__shape">
    <g stroke="currentColor" stroke-width="1.25">
      {art.circles.map(([cx, cy]) => (
        <circle cx={cx} cy={cy} r={art.r} vector-effect="non-scaling-stroke" />
      ))}
    </g>
    <g fill="currentColor">
      {points.map(([x, y]) => (
        <rect x="-2.6" y="-2.6" width="5.2" height="5.2" transform={`translate(${x} ${y}) rotate(45)`} />
      ))}
    </g>
    <g class="about-art__labels" fill="currentColor">
      {art.labels.map((label) => (
        <text x={label.x} y={label.y}>{label.text}</text>
      ))}
    </g>
  </g>
</svg>

<style>
  .about-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .about-art__labels {
    font-family: var(--font-mono);
    font-size: 13px;
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* Survol de la carte : les repères tournent d'un huitième de tour, la forme respire. */
  .about-art__markers,
  .about-art__shape {
    transform-box: view-box;
    transform-origin: 0 0;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.about-card:hover) .about-art__markers {
      transform: rotate(45deg);
    }

    :global(.about-card:hover) .about-art__shape {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-art__markers,
    .about-art__shape {
      transition: none;
    }
  }
</style>
