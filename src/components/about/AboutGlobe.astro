---
/**
 * Globe filaire de la page « L’agence » : contour, méridiens qui se rejoignent aux pôles et
 * un grand cercle incliné. Le hero en montre le haut, la section « vitesse » le bas.
 * Repère centré ; traits de 1px à toutes les tailles.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const R = 765;
// Méridiens : demi-largeur rapportée au rayon (relevés sur la maquette).
const meridians = [0.216, 0.47, 0.73, 0.85, 0.9];
---

<svg class={className} viewBox={`${-R - 1} ${-R - 1} ${2 * R + 2} ${2 * R + 2}`} fill="none" aria-hidden="true">
  <g stroke="currentColor" stroke-width="1">
    <circle r={R} vector-effect="non-scaling-stroke" />
    <ellipse rx={R} ry={635} vector-effect="non-scaling-stroke" />
    {meridians.map((k) => <ellipse rx={R * k} ry={R} vector-effect="non-scaling-stroke" />)}
    <path d={`M0 ${-R}V${R}`} vector-effect="non-scaling-stroke" />
  </g>
</svg>
