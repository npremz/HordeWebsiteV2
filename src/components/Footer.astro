---
/**
 * Footer global : « Let’s Talk », colonnes Services / Social / Menu,
 * bande From / Since, copyright, liens légaux et accès à Arthur.
 * Toujours sur fond lilas, quel que soit le thème de la page.
 */
import { DEFAULT_LOCALE, type Locale } from "../i18n";
import { getSiteChrome } from "../lib/site-data";
import { getFooterServiceLinks } from "../lib/content/services";
import { getHomeCopy } from "./home/copy";
import ArthurAvatar from "./home/svg/ArthurAvatar.astro";
import HomeIcon from "./home/svg/HomeIcon.astro";
import HomeBadge from "./home/ui/HomeBadge.astro";
import footerMark from "../assets/svg/contact/footer-mark.svg?raw";

interface Props {
	lang?: Locale;
	/** Conservés pour compatibilité avec les pages existantes ; sans effet sur ce footer. */
	variant?: "light" | "dark";
	hideOverflow?: boolean;
	innerBg?: boolean;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const copy = getHomeCopy(lang);
const { footer, navigation } = await getSiteChrome(lang);
const serviceLinks = await getFooterServiceLinks(lang);

const socialLinks = (footer.columns ?? []).flatMap((column) => column.links);
const menuItems = navigation.items ?? [];
const legalOrder = ["/cookies/", "/confidentialite/", "/mentions-legales/"];
const legalLinks = [...(footer.legalLinks ?? [])].sort(
	(a, b) => legalOrder.findIndex((path) => a.url.includes(path)) - legalOrder.findIndex((path) => b.url.includes(path)),
);
const contactHref = `/${lang}/contact/`;
const isMail = (url: string) => url.startsWith("mailto:");
const copyLabel = lang === "fr" ? "Copier l’adresse e-mail" : "Copy the email address";
const copiedLabel = lang === "fr" ? "Copié" : "Copied";
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<p class="site-footer__title">
			<a href={contactHref} class="site-footer__title-link" title={copy.talk.ctaLabel}>
				<span aria-hidden="true">{copy.talk.title}</span>
				<span class="sr-only">{copy.talk.title} — {copy.talk.ctaLabel}</span>
			</a>
		</p>

		<div class="site-footer__columns">
			{
				serviceLinks.length > 0 && (
					<nav class="site-footer__col site-footer__col--services" aria-label={copy.talk.services}>
						<h2 class="site-footer__heading">{copy.talk.services}</h2>
						<ul>
							{serviceLinks.map((link) => (
								<li><a href={link.url} class="site-footer__link site-footer__link--plain">{link.label}</a></li>
							))}
						</ul>
					</nav>
				)
			}
			<div class="site-footer__col site-footer__col--social">
				<h2 class="site-footer__heading">{copy.talk.social}</h2>
				<ul>
					{socialLinks.map((link) => (
						<li class="flex items-center gap-2.5">
							<a
								href={link.url}
								class="site-footer__link"
								target={link.isExternal && !isMail(link.url) ? "_blank" : undefined}
								rel={link.isExternal && !isMail(link.url) ? "noopener noreferrer" : undefined}
							>
								{isMail(link.url) ? "Email" : link.label}
							</a>
							{isMail(link.url) && (
								<button
									type="button"
									class="site-footer__copy"
									data-copy-text={link.url.replace("mailto:", "")}
									data-copied-label={copiedLabel}
									aria-label={copyLabel}
									title={copyLabel}
								>
									<svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="4.5" y="4.5" width="8" height="8" rx="2" stroke="currentColor" /><path d="M9.5 2.5a1 1 0 0 0-1-1h-5a2 2 0 0 0-2 2v5a1 1 0 0 0 1 1" stroke="currentColor" stroke-linecap="round" /></svg>
								</button>
							)}
						</li>
					))}
				</ul>
			</div>
			<nav class="site-footer__col site-footer__col--menu" aria-label={copy.talk.menu}>
				<h2 class="site-footer__heading">{copy.talk.menu}</h2>
				<ul>
					{menuItems.map((item) => (
						<li><a href={item.url} class="site-footer__link">{item.label}</a></li>
					))}
				</ul>
			</nav>
		</div>

		<div class="site-footer__band">
			<HomeBadge lang={lang} kind="from" tone="dark" class="site-footer__badge" />
			<a href={`/${lang}/`} class="site-footer__mark" aria-label={copy.brand.name} title={copy.brand.name}>
				<Fragment set:html={footerMark} />
			</a>
			<HomeBadge lang={lang} kind="since" tone="dark" class="site-footer__badge" />
		</div>

		<div class="site-footer__bottom">
			<p class="site-footer__copyright">
				{copy.footer.copyright} <span class="site-footer__muted">{copy.footer.description}</span>
			</p>
			<nav class="site-footer__legal" aria-label={copy.footer.legal}>
				{legalLinks.map((link) => (
					<a href={link.url} class="site-footer__link">{link.label}</a>
				))}
			</nav>
			<a href={contactHref} class="site-footer__assistant">
				<span class="site-footer__link">{copy.footer.assistant}</span>
				<span class="site-footer__avatar">
					<ArthurAvatar class="h-full w-full" />
				</span>
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: 0;
		container-type: inline-size;
		color: var(--color-black);
	}

	/* Fond lilas pleine largeur, même quand le footer vit dans un conteneur centré. */
	.site-footer::before {
		content: "";
		position: absolute;
		inset-block: 0;
		left: 50%;
		z-index: -1;
		width: 100vw;
		background: var(--color-bg);
		transform: translateX(-50%);
	}

	.site-footer__inner {
		padding: 4rem 0 2.5rem;
	}

	.site-footer__title {
		font-family: var(--font-sans);
		font-size: 25.5cqw;
		line-height: 0.9;
		letter-spacing: -0.055em;
		white-space: nowrap;
		text-align: center;
	}

	.site-footer__title-link {
		display: inline-block;
		transition: letter-spacing 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (hover: hover) {
		.site-footer__title-link:hover {
			letter-spacing: -0.07em;
		}
	}

	.site-footer__columns {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2.75rem 1.5rem;
		margin-top: 2.5rem;
	}

	.site-footer__col--services {
		grid-column: 1 / -1;
	}

	.site-footer__col--menu {
		text-align: right;
	}

	.site-footer__heading {
		padding-bottom: 0.5rem;
		margin-bottom: 0.9rem;
		border-bottom: 1px solid var(--color-black);
		font-family: var(--font-sans);
		font-size: 1.375rem;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	/* Sur mobile, le filet des titres Social et Menu ne fait qu'un. */
	.site-footer__col--social .site-footer__heading {
		margin-right: -1.5rem;
		padding-right: 1.5rem;
	}

	.site-footer__col ul {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 1.0625rem;
		line-height: 1.25;
	}

	.site-footer__link {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		transition: opacity 0.2s ease;
	}

	a.site-footer__link:hover,
	a:hover > .site-footer__link {
		opacity: 0.55;
	}

	.site-footer__copy {
		position: relative;
		display: inline-flex;
		width: 0.95rem;
		height: 0.95rem;
		cursor: pointer;
		transition: opacity 0.2s ease;
	}

	.site-footer__copy:hover {
		opacity: 0.55;
	}

	.site-footer__copy svg {
		width: 100%;
		height: 100%;
	}

	.site-footer__copy[data-copied]::after {
		content: attr(data-copied-label);
		position: absolute;
		left: calc(100% + 0.5rem);
		top: 50%;
		padding: 0.2rem 0.45rem;
		border-radius: 4px;
		background: var(--color-black);
		color: var(--color-white);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1;
		white-space: nowrap;
		transform: translateY(-50%);
	}

	.site-footer__band {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: 3.5rem;
	}

	.site-footer__band::before {
		content: "";
		position: absolute;
		left: 50%;
		top: 50%;
		width: 100vw;
		height: 1px;
		background: var(--color-black);
		transform: translateX(-50%);
	}

	.site-footer__band :global(.site-footer__badge) {
		display: none;
		position: relative;
		border-radius: 10px;
	}

	.site-footer__mark {
		position: relative;
		display: block;
		width: 8.25rem;
	}

	.site-footer__mark :global(svg) {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (hover: hover) {
		.site-footer__mark:hover :global(svg) {
			transform: rotate(180deg);
		}
	}

	.site-footer__bottom {
		display: grid;
		justify-items: center;
		gap: 2rem;
		margin-top: 1.5rem;
		text-align: center;
	}

	.site-footer__copyright {
		order: -2;
		font-size: 1.5rem;
		line-height: 1.12;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.site-footer__muted {
		color: rgb(22 25 27 / 0.45);
	}

	.site-footer__legal {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.0625rem;
		line-height: 1.25;
	}

	.site-footer__assistant {
		order: -1;
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 0.9rem;
		font-size: 1.0625rem;
	}

	.site-footer__avatar {
		position: relative;
		width: 3.4rem;
		height: 3.4rem;
		flex: none;
		border: 3px solid var(--color-black);
		border-radius: 999px;
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.site-footer__avatar::after {
		content: "";
		position: absolute;
		top: -0.3rem;
		right: -0.3rem;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: #3ee06b;
	}

	@media (hover: hover) {
		.site-footer__assistant:hover .site-footer__avatar {
			transform: rotate(-12deg) scale(1.06);
		}
	}

	@media (min-width: 640px) {
		.site-footer__inner {
			padding-top: 5rem;
		}

		.site-footer__bottom {
			grid-template-columns: 1fr auto;
			justify-items: stretch;
			align-items: end;
			gap: 2.5rem 2rem;
			text-align: left;
		}

		.site-footer__copyright {
			max-width: 22rem;
			text-wrap: initial;
		}

		.site-footer__assistant {
			align-items: flex-end;
		}

		.site-footer__legal {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 1024px) {
		.site-footer__inner {
			padding: 7rem 0 3.25rem;
		}

		.site-footer__columns {
			grid-template-columns: 1fr auto auto;
			gap: 2rem clamp(5rem, 12cqw, 12rem);
			margin-top: 4.5rem;
		}

		.site-footer__col--services {
			grid-column: auto;
		}

		.site-footer__heading,
		.site-footer__col--social .site-footer__heading {
			margin: 0 0 1.9rem;
			padding: 0;
			border-bottom: 0;
			font-size: 1.625rem;
		}

		.site-footer__col ul {
			gap: 0.6rem;
		}

		.site-footer__link--plain {
			text-decoration: none;
		}

		.site-footer__band {
			justify-content: space-between;
			margin-top: 6rem;
		}

		.site-footer__band :global(.site-footer__badge) {
			display: inline-flex;
		}

		.site-footer__bottom {
			grid-template-columns: 1fr auto 1fr;
			margin-top: 4.5rem;
		}

		.site-footer__legal {
			grid-column: auto;
			gap: 0.75rem;
		}

		.site-footer__assistant {
			order: 0;
			flex-direction: row;
			align-items: center;
			justify-self: end;
		}
	}
</style>

<script>
	// Boutons « copier » ([data-copy-text]) : footer et page contact.
	const win = window as Window & { __hordeCopyBound?: boolean };
	if (!win.__hordeCopyBound) {
		win.__hordeCopyBound = true;
		document.addEventListener("click", (event) => {
			const button = (event.target as Element | null)?.closest<HTMLElement>("[data-copy-text]");
			if (!button) return;
			const text = button.dataset.copyText ?? "";
			const done = () => {
				button.dataset.copied = "true";
				window.setTimeout(() => delete button.dataset.copied, 1600);
				button.dispatchEvent(new CustomEvent("horde:copied", { bubbles: true }));
			};
			if (navigator.clipboard?.writeText) {
				navigator.clipboard.writeText(text).then(done, () => {
					window.location.href = `mailto:${text}`;
				});
			} else {
				window.location.href = `mailto:${text}`;
			}
		});
	}
</script>
