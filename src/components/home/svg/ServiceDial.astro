---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Plaque en croix : anneau central (R) + 4 bras à 45°, contour calculé en un seul tracé.
const C = 216;
const R = 134;
const halfArm = 36;
const armLength = 184;
const corner = 16;
const along = Math.sqrt(R * R - halfArm * halfArm);
const point = (angle: number, x: number, y: number) => {
  const cos = Math.cos(angle);
  const sin = Math.sin(angle);
  return `${(C + x * cos - y * sin).toFixed(2)} ${(C + x * sin + y * cos).toFixed(2)}`;
};

const arms = [45, 135, 225, 315].map((deg) => (deg * Math.PI) / 180);
let plate = "";
arms.forEach((angle, index) => {
  const start = point(angle, along, -halfArm);
  const next = arms[(index + 1) % arms.length];
  plate += `${index === 0 ? "M" : "L"}${start}`;
  plate += `L${point(angle, armLength - corner, -halfArm)}`;
  plate += `Q${point(angle, armLength, -halfArm)} ${point(angle, armLength, -halfArm + corner)}`;
  plate += `L${point(angle, armLength, halfArm - corner)}`;
  plate += `Q${point(angle, armLength, halfArm)} ${point(angle, armLength - corner, halfArm)}`;
  plate += `L${point(angle, along, halfArm)}`;
  plate += `A${R} ${R} 0 0 1 ${point(next, along, -halfArm)}`;
});
plate += "Z";
---

<svg class:list={["service-dial", className]} viewBox="0 0 432 432" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect x="5" y="9" width="422" height="414" rx="150" stroke="#2f3134" stroke-width="5" />
  <rect x="15" y="19" width="402" height="394" rx="140" stroke="#26282b" stroke-width="2" />
  <rect x="196" y="3" width="40" height="8" rx="3" fill="#2f3134" />
  <rect x="196" y="421" width="40" height="8" rx="3" fill="#2f3134" />
  <rect x="0" y="196" width="8" height="40" rx="3" fill="#2f3134" />
  <rect x="424" y="196" width="8" height="40" rx="3" fill="#2f3134" />
  <g class="service-dial__plate" data-service-dial-plate>
    <path d={plate} stroke="#2a2c2f" stroke-width="1.5" />
    <circle cx={C} cy={C} r="98" stroke="#2a2c2f" stroke-width="1.5" />
    <!-- Molette : export Figma (Group 3200, 50 × 50), anneau masqué remplacé par un trait centré équivalent. -->
    <g transform="translate(212.94 242.94) scale(1.124)">
      <circle cx="24.6" cy="24.6" r="24.6" fill="var(--color-button-white)" />
      <ellipse cx="24.553" cy="24.776" rx="17.95" ry="17.52" stroke="#5b5960" stroke-width="6" />
      <path d="M29.8948 21.4262L29.7222 21.6076C28.0213 23.49 28.051 26.3781 29.8085 28.2269L37.0105 35.4288L35.5435 36.8958L28.4294 29.7816C26.536 27.8886 23.4736 27.8794 21.5682 29.7528L14.4252 36.8958L12.9583 35.4288L20.1484 28.2387C21.9662 26.3401 21.9512 23.3348 20.1027 21.4549L12.8867 14.239L14.3537 12.7721L21.6168 20.0352C23.4953 21.834 26.4567 21.8377 28.3401 20.047L35.6151 12.7721L37.082 14.239L29.8948 21.4262Z" fill="#5b5960" />
    </g>
  </g>
</svg>

<style>
  .service-dial path,
  .service-dial circle,
  .service-dial rect,
  .service-dial ellipse {
    vector-effect: none;
  }

  .service-dial__plate {
    transform-origin: 216px 216px;
    transform: rotate(var(--dial-rotation, 0deg));
  }
</style>
