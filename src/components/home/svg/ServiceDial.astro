</span>

<style>
  .service-dial {
    position: relative;
    display: block;
  }

  .service-dial__base {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 12°/s : un tour en 30 s. Le JS accélère l'animation au scroll (playbackRate).
     `transform` et pas la propriété `rotate` : sur un <svg>, Chromium n'anime `rotate` que sur le
     thread principal (re-découpage des calques à chaque image), alors que `transform` passe au GPU. */
  .service-dial__plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: service-dial-spin 30s linear infinite;
  }

  @keyframes service-dial-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-dial__plate {
      animation: none;
    }
  }
</style>
