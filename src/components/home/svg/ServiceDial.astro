---
/**
 * Cadran des services (export Figma « Group 3502 ») ; les rayons et la molette tournent en continu,
 * plus vite au scroll. Le plateau tournant est un <svg> à part, superposé au fond : on anime
 * l'élément entier (rotation sur le GPU), au lieu d'un <g> interne qui forçait layout + repaint
 * du cadran à chaque image. Son centre de rotation est le centre du viewBox (232,5).
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

