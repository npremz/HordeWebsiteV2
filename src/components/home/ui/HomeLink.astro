---
import { HOME_ICONS } from "../svg/icons";
import "./home-link.css";

interface Props {
  href: string;
  label: string;
  class?: string;
  /** "dark" = texte noir + bouton noir (fonds clairs). */
  tone?: "dark" | "light";
  /** "plus" (défaut) ou "arrow" (flèche ↗, pour les liens qui quittent le site). */
  icon?: "plus" | "arrow";
  /** Ouvre dans un nouvel onglet ; `newTabLabel` est lu par les lecteurs d'écran. */
  external?: boolean;
  newTabLabel?: string;
}

const { href, label, class: className = "", tone = "dark", icon = "plus", external = false, newTabLabel } = Astro.props;
---

<a
  href={href}
  class:list={["home-link group", `home-link--${tone}`, `home-link--${icon}`, className]}
  {...(external ? { target: "_blank", rel: "noopener" } : {})}
>
  <span class="home-link__label">{label}</span>
  {external && newTabLabel && <span class="sr-only"> {newTabLabel}</span>}
  <span class="home-link__button" aria-hidden="true">
    {icon === "arrow" ? (
      <svg class="home-link__arrow" viewBox="0 0 16 20" fill="currentColor">
        <path d={HOME_ICONS.arrowDown.paths[0].d} />
      </svg>
    ) : (
      <svg viewBox="0 0 8.86 9.1" fill="currentColor">
        <path d={HOME_ICONS.plus.paths[0].d} />
      </svg>
    )}
  </span>
</a>
