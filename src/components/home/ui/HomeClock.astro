---
import type { Locale } from "../../../i18n";
import { getHomeCopy } from "../copy";
import HomeIcon from "../svg/HomeIcon.astro";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className = "" } = Astro.props;
const copy = getHomeCopy(lang);
// Le soleil est l’état par défaut ; le script affiche le picto du temps actuel.
const weatherIcons = [
  { kind: "sun", name: "sun" },
  { kind: "cloud", name: "weatherCloud" },
  { kind: "rain", name: "weatherRain" },
  { kind: "snow", name: "weatherSnow" },
  { kind: "storm", name: "weatherStorm" },
] as const;
---

<div class:list={["home-clock flex items-center gap-3", className]} data-home-clock data-days={JSON.stringify(copy.hero.days)}>
  <span class="flex items-center gap-2 font-mono text-[0.8125rem] uppercase leading-none tracking-[0.02em]">
    <HomeIcon name="watch" class="w-[0.55rem]" />
    <span>[<span data-home-clock-time>---_--:--:--</span>_<span data-home-clock-temp>--</span>°]</span>
  </span>
  <span
    class="home-clock__weather"
    role="img"
    aria-label={copy.hero.weatherLabel}
  >
    {weatherIcons.map((icon) => (
      <HomeIcon
        name={icon.name}
        class="w-[0.95rem]"
        data-home-weather={icon.kind}
        style={icon.kind === "sun" ? undefined : "display: none"}
      />
    ))}
  </span>
</div>

<style>
  /* Mobile : anneau gris fin, icône blanche. Dès 640px : disque blanc cerclé de gris à l’intérieur. */
  .home-clock__weather {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 999px;
    color: var(--color-white);
    box-shadow: inset 0 0 0 1px rgb(244 241 248 / 0.5);
  }

  @media (min-width: 640px) {
    .home-clock__weather {
      width: 2.375rem;
      height: 2.375rem;
      background: var(--color-button-white);
      color: var(--color-black);
      box-shadow:
        inset 0 0 0 2px var(--color-button-white),
        inset 0 0 0 3px #8b8990;
    }
  }

  @media (min-width: 1512px) {
    .home-clock__weather {
      width: 2.5625rem;
      height: 2.5625rem;
    }
  }
</style>

<script>
  // Codes WMO renvoyés par open-meteo → picto affiché.
  function weatherKind(code: number) {
    if (code <= 1) return "sun";
    if (code >= 95) return "storm";
    if ((code >= 71 && code <= 77) || code === 85 || code === 86) return "snow";
    if (code >= 51) return "rain";
    return "cloud";
  }

  let clockTimer: number | undefined;
  let weatherTimer: number | undefined;

  const pad = (value: number) => value.toString().padStart(2, "0");

  function tick() {
    const now = new Date();
    document.querySelectorAll<HTMLElement>("[data-home-clock]").forEach((clock) => {
      const days = JSON.parse(clock.dataset.days || "[]") as string[];
      const target = clock.querySelector<HTMLElement>("[data-home-clock-time]");
      if (!target) return;
      target.textContent = `${days[now.getDay()] ?? ""}_${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
    });
  }

  async function fetchWeather() {
    try {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 5000);
      const response = await fetch(
        "https://api.open-meteo.com/v1/forecast?latitude=50.8503&longitude=4.3517&current_weather=true",
        { signal: controller.signal },
      );
      window.clearTimeout(timeout);
      const data = await response.json();
      const temp = Math.round(data.current_weather.temperature);
      const kind = weatherKind(Number(data.current_weather.weathercode));

      document.querySelectorAll<HTMLElement>("[data-home-clock-temp]").forEach((el) => {
        el.textContent = String(temp);
      });
      document.querySelectorAll<SVGElement>("[data-home-weather]").forEach((el) => {
        el.style.display = el.dataset.homeWeather === kind ? "" : "none";
      });
    } catch {
      // On garde les valeurs par défaut si l'API ne répond pas.
    }
  }

  function initHomeClock() {
    window.clearInterval(clockTimer);
    window.clearInterval(weatherTimer);
    if (!document.querySelector("[data-home-clock]")) return;

    tick();
    fetchWeather();
    clockTimer = window.setInterval(tick, 1000);
    weatherTimer = window.setInterval(fetchWeather, 15 * 60 * 1000);
  }

  initHomeClock();
  document.addEventListener("astro:after-swap", initHomeClock);
</script>
