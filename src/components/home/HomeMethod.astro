---
import type { Locale } from "../../i18n";
import diagramSvg from "../../assets/svg/home/method-diagram.svg?raw";
import ringsSvg from "../../assets/svg/home/method-diagram-rings.svg?raw";
import { getHomeCopy } from "./copy";
import HomeIcon from "./svg/HomeIcon.astro";
import HomeLink from "./ui/HomeLink.astro";
import SlashMark from "./ui/SlashMark.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getHomeCopy(lang);
const steps = copy.method.steps;
const fractions = ["fraction1", "fraction2", "fraction3"] as const;
// Chaque anneau dans son propre <svg> superposé au fond : on anime un élément entier (calque
// composité) au lieu d'un <g> interne, qui forçait layout + repaint à chaque image.
const rings = ringsSvg.match(/<g class="method-diagram__ring"[^>]*>[\s\S]*?<\/g>/g) ?? [];
---

<section id="demarche" data-header-theme="light" data-pause-offscreen class="home-method relative z-20 bg-white pb-16 pt-14 md:pb-24 md:pt-16">
  <div class="home-column home-column--wide">
    <h2 class="home-method__title">
      <svg class="home-method__paren" viewBox="0 0 16 90" fill="none" aria-hidden="true">
        <path d="M14 1C4 22 2 38 2 45C2 52 4 68 14 89" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span>
        <span class="block">{copy.method.titleLine1}</span>
        <span class="block">{copy.method.titleLine2}</span>
      </span>
      <svg class="home-method__paren" viewBox="0 0 16 90" fill="none" aria-hidden="true">
        <path d="M2 1C12 22 14 38 14 45C14 52 12 68 2 89" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </h2>

    <div class="home-method__diagram" aria-hidden="true">
      <div class="home-method__figure">
        <Fragment set:html={diagramSvg} />
        {rings.map((ring, index) => (
          <svg class="home-method__ring" viewBox="0 0 381 237" fill="none" style={`--ring: ${index}`} set:html={ring} />
        ))}
      </div>
      <span class="home-method__label home-method__label--left">{copy.method.stepsLabel}</span>
      <span class="home-method__label home-method__label--right">{copy.method.mindLabel}</span>
    </div>

    <!-- Arbre : la carte se ramifie vers les trois étapes (desktop) ; simple trait central sinon. -->
    <div class="home-method__tree" aria-hidden="true">
      <span class="home-method__branch home-method__branch--left"><i></i><b></b></span>
      <span class="home-method__branch home-method__branch--center"></span>
      <span class="home-method__branch home-method__branch--right"><i></i><b></b></span>
      <span class="home-method__label home-method__label--left">{copy.method.stepsLabel}</span>
      <span class="home-method__label home-method__label--right">{copy.method.mindLabel}</span>
    </div>

    <ol class="home-method__steps">
      {steps.map((step, index) => (
        <li class="home-method__step">
          <h3 class="home-method__card">
            <HomeIcon name={fractions[index]} class="w-[0.6rem] md:w-[0.65rem]" />
            <span class="flex-1 text-center">{step.title}</span>
          </h3>
          <p class="home-method__text">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-12 flex items-center justify-between md:mt-20">
      <HomeLink href={`/${lang}/services/`} label={copy.method.link} />
      <SlashMark />
    </div>
  </div>
</section>

<style>
  .home-method {
    --gap: 4rem;
    --line: #5d5b61;
  }

  .home-method__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: clamp(1.5rem, 7vw, 3.25rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-align: center;
  }

  .home-method__paren {
    width: 0.5em;
    height: 1.3em;
    flex: none;
  }

  .home-method__diagram {
    position: relative;
    display: flex;
    justify-content: center;
    max-width: 380px;
    margin: 2.5rem auto 0;
    border-radius: 5px;
    background: var(--color-bg-light);
  }

  /* Mobile : box plus petite. */
  @media (max-width: 639px) {
    .home-method__diagram {
      max-width: 250px;
    }
  }

  /* Fond + traits (SVG de base) ; les anneaux sont superposés et coupés au bord de la box. */
  .home-method__figure {
    position: relative;
    width: min(100%, 23.8rem);
    overflow: hidden;
    border-radius: 4px;
  }

  .home-method__figure > :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
   * Boucle « escalier » : chaque anneau tombe du haut de la box, se pose, puis repart vers le bas,
   * avec un décalage de 0,25 s entre 1/3, 2/3 et 3/3. On anime le <svg> entier en transform :
   * le navigateur le gère sur le GPU, sans layout ni repaint. (72 % de la hauteur de la box
   * = 170 unités sur 237, assez pour sortir un anneau.)
   */
  .home-method__figure > .home-method__ring {
    position: absolute;
    inset: 0;
    height: 100%;
    animation: method-ring-drop 3.6s cubic-bezier(0.77, 0, 0.18, 1) infinite both;
    animation-delay: calc(var(--ring) * 0.25s);
  }

  @keyframes method-ring-drop {
    0% {
      transform: translateY(-72%);
    }
    18%,
    72% {
      transform: translateY(0);
    }
    90%,
    100% {
      transform: translateY(72%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-method__figure > .home-method__ring {
      animation: none;
    }
  }

  .home-method__label {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Mobile / tablette : les libellés sont juste sous la box, de part et d'autre du trait central. */
  .home-method__diagram .home-method__label {
    top: calc(100% + 0.6rem);
    max-width: 5.5rem;
  }

  .home-method__diagram .home-method__label--left {
    left: 0;
  }

  .home-method__diagram .home-method__label--right {
    right: 0;
    text-align: right;
  }

  .home-method__tree {
    position: relative;
    height: 3.5rem;
  }

  .home-method__tree .home-method__label,
  .home-method__branch--left,
  .home-method__branch--right {
    display: none;
  }

  .home-method__branch--center {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--line);
  }

  .home-method__steps {
    display: grid;
    gap: 2.75rem;
  }

  .home-method__card {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.85rem;
    border: 2px solid #d6d2da;
    border-radius: 6px;
    background: var(--color-bg-light);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .home-method__text {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    text-indent: 5rem;
  }

  @media (min-width: 640px) {
    .home-method__title {
      justify-content: center;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .home-method__title {
      justify-content: space-between;
      padding-inline: 1.5rem;
      font-size: 4rem;
    }

    .home-method {
      /* Largeur du schéma : sert aussi à placer les branches sous ses traits verticaux. */
      --diagram-w: 19.4rem;
    }

    .home-method__diagram {
      width: var(--diagram-w);
      margin: 3.5rem auto 0;
      padding-bottom: 0;
      background: none;
    }

    .home-method__diagram .home-method__label {
      display: none;
    }

    /* Colonne 1 / 3 : centre = (largeur − 2 gouttières) / 6. */
    .home-method__tree {
      --col: calc((100% - 2 * var(--gap)) / 6);
      /*
       * Écart entre le centre et chaque trait vertical du SVG (x = 146.977 et 234.617 sur un
       * viewBox de 381, centré) ; − 0,5px car la branche trace son trait de 1px à côté de ce bord.
       */
      --stem-left: calc(var(--diagram-w) * (190.5 - 146.977) / 381 - 0.5px);
      --stem-right: calc(var(--diagram-w) * (234.617 - 190.5) / 381 - 0.5px);
      height: 9rem;
    }

    .home-method__branch--left,
    .home-method__branch--right {
      display: block;
    }

    .home-method__branch i,
    .home-method__branch b {
      position: absolute;
      border: 0 solid var(--line);
    }

    /* Descente depuis la carte puis palier horizontal. */
    .home-method__branch i {
      top: 0;
      height: 3rem;
      border-bottom-width: 1px;
    }

    /* Descente vers l'étape. */
    .home-method__branch b {
      top: calc(3rem - 1px);
      bottom: 0;
      width: 0.75rem;
      border-top-width: 1px;
    }

    .home-method__branch--left i {
      left: calc(var(--col) + 0.75rem);
      right: calc(50% + var(--stem-left));
      border-right-width: 1px;
      border-bottom-right-radius: 0.6rem;
    }

    .home-method__branch--left b {
      left: var(--col);
      border-left-width: 1px;
      border-top-left-radius: 0.6rem;
    }

    .home-method__branch--right i {
      right: calc(var(--col) + 0.75rem);
      left: calc(50% + var(--stem-right));
      border-left-width: 1px;
      border-bottom-left-radius: 0.6rem;
    }

    .home-method__branch--right b {
      right: var(--col);
      border-right-width: 1px;
      border-top-right-radius: 0.6rem;
    }

    .home-method__tree .home-method__label {
      display: block;
      top: 1.75rem;
    }

    .home-method__tree .home-method__label--left {
      left: var(--col);
    }

    .home-method__tree .home-method__label--right {
      right: var(--col);
    }

    .home-method__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto auto;
      gap: 0 var(--gap);
    }

    /* Cartes et textes sur deux rangées communes : si un titre passe sur 2 lignes, les 3 cartes
       gardent la même hauteur et les textes démarrent à la même hauteur. */
    .home-method__step {
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
    }

    .home-method__card {
      min-height: 3.3rem;
      font-size: 1.375rem;
    }

    .home-method__text {
      margin-top: 1.75rem;
    }
  }

  @media (min-width: 1512px) {
    .home-method__title {
      font-size: 4.9rem;
    }
  }
</style>
