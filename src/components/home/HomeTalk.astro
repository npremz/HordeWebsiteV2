---
import type { Locale } from "../../i18n";
import { getHomeCopy } from "./copy";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getHomeCopy(lang);
const contactHref = `/${lang}/contact/`;

// Cœur pixel 9 × 8 : contour (o) et intérieur (x), rempli rangée par rangée depuis le bas.
const HEART = [
  ".oo...oo.",
  "oxxo.oxxo",
  "oxxxoxxxo",
  "oxxxxxxxo",
  ".oxxxxxo.",
  "..oxxxo..",
  "...oxo...",
  "....o....",
];
const cells = HEART.flatMap((row, y) => [...row].map((kind, x) => ({ kind, x, y }))).filter((cell) => cell.kind !== ".");
---

<section id="contact" data-header-theme="light" class="home-talk relative bg-bg" data-home-like data-level="0">
  <div class="home-talk__bar">
    <p class="home-talk__label">
      {copy.talk.liked}
      <span class="home-talk__heart" aria-hidden="true">
        <svg viewBox="0 0 9 8" shape-rendering="crispEdges">
          {cells.map(({ kind, x, y }) => (
            <rect
              class={kind === "x" ? "home-talk__fill" : undefined}
              style={kind === "x" ? `--row: ${7 - y}` : undefined}
              x={x}
              y={y}
              width="1.02"
              height="1.02"
            />
          ))}
        </svg>
        <span class="home-talk__burst">
          {Array.from({ length: 6 }, (_, i) => <i style={`--i: ${i}`}></i>)}
        </span>
      </span>
    </p>

    <div class="home-talk__keys">
      <button type="button" class="home-talk__key" data-like-level="1" aria-pressed="false"><span>{copy.talk.yes}</span></button>
      <button type="button" class="home-talk__key" data-like-level="2" aria-pressed="false"><span>{copy.talk.yesReally}</span></button>
    </div>

    <a href={contactHref} class="home-talk__label home-talk__connect">{copy.talk.connect}</a>
  </div>
</section>

<style>
  .home-talk {
    padding-block: 1rem 3.5rem;
    overflow-x: clip;
  }

  .home-talk__bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 0.75rem;
    padding-inline: 1rem;
  }

  .home-talk__bar::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    /* Mobile : la ligne passe dans les deux étiquettes, les touches sont dessous. */
    top: 0.375rem;
    height: 1px;
    background: var(--color-black);
  }

  .home-talk__label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-inline: 0.9rem;
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .home-talk__connect {
    margin-left: auto;
    transition: letter-spacing 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-talk__connect:hover {
    letter-spacing: 0.14em;
  }

  /* Cœur : contour toujours visible, intérieur rempli rangée par rangée. */
  .home-talk__heart {
    position: relative;
    display: inline-block;
    width: 1.05rem;
  }

  .home-talk__heart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: var(--color-black);
  }

  .home-talk__fill {
    fill: var(--color-err);
    opacity: 0;
    transition: opacity 0.01s linear;
    /* Vidage : du haut vers le bas, rapide. */
    transition-delay: calc((6 - var(--row)) * 35ms);
  }

  /* Niveau 1 : la moitié basse ; niveau 2 : tout le cœur. */
  .home-talk[data-level="1"] .home-talk__fill[style*="--row: 1"],
  .home-talk[data-level="1"] .home-talk__fill[style*="--row: 2"],
  .home-talk[data-level="1"] .home-talk__fill[style*="--row: 3"],
  .home-talk[data-level="2"] .home-talk__fill {
    opacity: 1;
    transition-delay: calc(var(--row) * 90ms);
  }

  .home-talk[data-level="2"] .home-talk__heart svg {
    animation: home-talk-beat 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s 2;
  }

  /* Éclats de pixels quand le cœur est plein. */
  .home-talk__burst i {
    --angle: calc(var(--i) * 60deg + 30deg);
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3px;
    height: 3px;
    margin: -1.5px;
    background: var(--color-err);
    opacity: 0;
  }

  .home-talk.is-bursting .home-talk__burst i {
    animation: home-talk-burst 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }

  @keyframes home-talk-beat {
    0%, 100% { transform: scale(1); }
    40% { transform: scale(1.45); }
  }

  @keyframes home-talk-burst {
    0% { opacity: 1; transform: rotate(var(--angle)) translateY(0); }
    100% { opacity: 0; transform: rotate(var(--angle)) translateY(-1.4rem); }
  }

  .home-talk__keys {
    position: relative;
    order: 3;
    display: flex;
    gap: 2px;
    width: 100%;
  }

  /* Touches de clavier : socle clair, capuchon en creux qui s'enfonce. */
  .home-talk__key {
    display: flex;
    padding: 0.75rem 0.7rem;
    border-radius: 8px;
    background: var(--color-white);
    cursor: pointer;
  }

  .home-talk__key span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 3.4rem;
    height: 3.4rem;
    padding-inline: 1.1rem;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow:
      inset 0 0.25rem 0.4rem rgb(255 255 255 / 0.9),
      inset 0 -0.2rem 0.35rem rgb(15 16 17 / 0.07),
      0 0 0 1px rgb(15 16 17 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1;
    white-space: nowrap;
    transition:
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s ease,
      color 0.2s ease;
  }

  .home-talk__key:active span,
  .home-talk__key[aria-pressed="true"] span {
    transform: translateY(1px) scale(0.96);
    box-shadow:
      inset 0 0.2rem 0.4rem rgb(15 16 17 / 0.16),
      inset 0 -0.1rem 0.2rem rgb(255 255 255 / 0.8);
  }

  .home-talk__key[aria-pressed="true"] span {
    color: #d92f2f;
  }

  .home-talk__key:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .home-talk {
      padding-block: 1rem 5rem;
    }

    .home-talk__bar {
      gap: 3.25rem;
      padding-inline: 2rem;
    }

    .home-talk__bar::before {
      top: 50%;
    }

    .home-talk__keys {
      order: 0;
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .home-talk__bar {
      padding-inline: 3.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-talk__fill {
      transition-delay: 0s !important;
    }

    .home-talk[data-level="2"] .home-talk__heart svg,
    .home-talk.is-bursting .home-talk__burst i {
      animation: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = "horde-home-like";

  function initHomeLike() {
    const root = document.querySelector<HTMLElement>("[data-home-like]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const keys = [...root.querySelectorAll<HTMLButtonElement>("[data-like-level]")];

    const setLevel = (level: number, animate: boolean) => {
      root.dataset.level = String(level);
      keys.forEach((key) => key.setAttribute("aria-pressed", String(Number(key.dataset.likeLevel) === level)));
      root.classList.remove("is-bursting");
      if (animate && level === 2) {
        void root.offsetWidth; // relance l'animation des éclats
        root.classList.add("is-bursting");
      }
    };

    try {
      setLevel(Number(localStorage.getItem(STORAGE_KEY)) || 0, false);
    } catch {}

    keys.forEach((key) => {
      key.addEventListener("click", () => {
        const level = Number(key.dataset.likeLevel);
        // Recliquer sur la touche active vide le cœur.
        const next = root.dataset.level === String(level) ? 0 : level;
        setLevel(next, true);
        try {
          localStorage.setItem(STORAGE_KEY, String(next));
        } catch {}
      });
    });
  }

  initHomeLike();
  document.addEventListener("astro:page-load", initHomeLike);
</script>
