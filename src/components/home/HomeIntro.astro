---
import type { Locale } from "../../i18n";
import { getHomeCopy } from "./copy";
import HomeIcon from "./svg/HomeIcon.astro";
import { HOME_ICONS } from "./svg/icons";
import HomeLink from "./ui/HomeLink.astro";
import SlashMark from "./ui/SlashMark.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getHomeCopy(lang);
---

<section id="about" class="home-intro relative bg-bg pb-20 max-[399px]:pb-12 sm:pb-24 md:pb-28">
  <div class="home-column relative">
    <div class="flex items-start justify-between gap-4">
      <a href={`/${lang}/contact/`} class="home-intro__cta group">
        <span class="hidden sm:inline">{copy.intro.cta}</span>
        <span class="sm:hidden">{copy.intro.ctaShort}</span>
        <span class="home-intro__cta-button" aria-hidden="true">
          <svg viewBox="0 0 22 22" fill="currentColor">
            <path d={HOME_ICONS.spark.paths[0].d} />
          </svg>
        </span>
      </a>
      <span class="home-intro__tag hidden sm:inline-flex">
        {copy.intro.tag} <HomeIcon name="heart" class="w-[0.7rem]" />
      </span>
    </div>

    <SlashMark class="mt-8 md:mt-12" />

    <p class="home-lead mt-6 md:mt-12">
      <span class="home-lead__label">{copy.intro.label}</span>
      {copy.intro.text}
    </p>

    <div class="mt-8 flex items-center justify-between sm:justify-end md:mt-14">
      <HomeIcon name="arrowDown" class="w-[0.8rem] sm:hidden" />
      <HomeLink href={`/${lang}/services/`} label={copy.intro.link} />
    </div>
  </div>
</section>

<style>
  .home-intro__cta {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    height: 2.5rem;
    padding: 3px 3px 3px 0.9rem;
    border-radius: 0 0 8px 8px;
    background: var(--color-black);
    color: var(--color-white);
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  .home-intro__cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: 5.75rem;
    border-radius: 6px;
    background: var(--color-button-white);
    color: var(--color-black);
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-intro__cta-button svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .home-intro__cta:hover .home-intro__cta-button {
      width: 7.5rem;
    }

    .home-intro__cta:hover .home-intro__cta-button svg {
      transform: rotate(90deg);
    }
  }

  .home-intro__tag {
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding-inline: 1rem;
    border-radius: 0 0 4px 4px;
    background: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 399px) {
    .home-intro__cta {
      gap: 0.75rem;
      font-size: 0.9rem;
    }

    .home-intro__cta-button {
      width: 4.5rem;
    }
  }

  @media (min-width: 640px) {
    .home-intro__cta {
      width: auto;
      min-width: 28rem;
      font-size: 1.0625rem;
    }

    .home-intro__cta-button {
      width: 8.75rem;
    }

    @media (hover: hover) {
      .home-intro__cta:hover .home-intro__cta-button {
        width: 10.5rem;
      }
    }
  }
</style>
