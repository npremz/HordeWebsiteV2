---
/**
 * Page contact : formulaire conversationnel animé par Arthur.
 * Arthur pose les questions une à une ; on répond avec les puces ou dans le prompt.
 * Les champs et la validation reprennent ceux de ContactForm (POST /api/contact).
 */
import { type Locale, useTranslations } from "../../i18n";
import ArthurBubble from "../arthur/ArthurBubble.astro";
import { getContactCopy } from "./copy";
import compass from "../../assets/svg/contact/compass.svg?raw";
import crosshair from "../../assets/svg/contact/crosshair.svg?raw";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = getContactCopy(lang);
const email = "hello@hordeagence.com";
const bookCallHref = "https://calendly.com/ni-premont/30min";

const config = {
  copy,
  email,
  cultureHref: `/${lang}/about/`,
  pagePath: `/${lang}/contact/`,
  needs: [
    { value: "audit-offert", label: t.form.options.auditOffert },
    { value: "creation-ecommerce", label: t.form.options.creationEcommerce },
    { value: "creation-landing-page", label: t.form.options.creationLandingPage },
    { value: "creation-mvp-saas", label: t.form.options.creationMvpSaas },
    { value: "applications-evenementielles", label: t.form.options.applicationsEvenementielles },
    { value: "optimisation-site-web", label: t.form.options.optimisationSiteWeb },
    { value: "refonte-site-web", label: t.form.options.refonteSiteWeb },
    { value: "autre", label: t.form.options.autre },
  ],
  errors: {
    required: t.form.requiredField,
    invalidEmail: t.form.invalidEmail,
    maxLength: `${t.form.maxLengthPrefix} {max} ${t.form.maxLengthSuffix}`,
  },
};

// Graduations décoratives : longueur de chaque trait, en %.
// Égaliseur de la voix d'Arthur : nombre de barres.
const ticks = Array.from({ length: 22 });
---

<section class="cc" data-contact-console data-config={JSON.stringify(config)}>
  <div class="cc__band" aria-hidden="true"></div>
  <h1 class="sr-only">{copy.srTitle}</h1>

  <div class="cc__grid">
    <aside class="cc__side">
      <div class="cc__arthur">
        <div class="cc__bubble">
          <ArthurBubble id="contact-arthur" label={copy.arthurLabel} />
        </div>
        <p class="cc__name" aria-hidden="true">{copy.arthurName}</p>
      </div>
      <div class="cc__rail" aria-hidden="true">
        <span class="cc__rail-tick"></span>
        <p>{copy.sideTagline.map((line) => <span class="block">{line}</span>)}</p>
        <span class="cc__rail-tick"></span>
        <p>{copy.sideSince}</p>
        <span class="cc__rail-tick"></span>
        <span class="cc__compass"><Fragment set:html={compass} /></span>
      </div>
    </aside>

    <form class="cc__panel" data-cc-form novalidate>
      <div class="cc__head">
        <div class="cc__dialog">
          <p class="cc__prev" data-cc-prev>{copy.greeting}</p>
          <p class="cc__question">
            <span data-cc-question aria-hidden="true">{copy.questions.intent}</span><span class="cc__caret" aria-hidden="true"></span>
          </p>
          <p class="sr-only" aria-live="polite" data-cc-live></p>
        </div>
        <button type="button" class="cc__back-round" data-cc-back aria-label={copy.actions.back} title={copy.actions.back} disabled>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 10.5h7a3 3 0 0 0 0-6H5.5" stroke="currentColor" stroke-width="1.2" /><path d="M5.5 8 3 10.5 5.5 13" stroke="currentColor" stroke-width="1.2" /></svg>
        </button>
      </div>

      <div class="cc__stage">
        <div class="cc__main">
          <div class="cc__chips" data-cc-chips role="group" aria-label={copy.prompt.choose}></div>
          <!-- Tablette et desktop : aux étapes de saisie, le champ vient ici, sous la question. -->
          <div class="cc__slot cc__slot--top" data-cc-slot-top></div>
          <div class="cc__recap" data-cc-recap></div>
          <noscript>
            <p class="cc__noscript">{copy.noscript} <a href={`mailto:${email}`}>{email}</a>.</p>
          </noscript>
        </div>
        <div class="cc__ruler" data-cc-ruler aria-hidden="true">
          {ticks.map(() => <i></i>)}
          <b></b>
        </div>
      </div>

      <div class="cc__composer">
        <div class="cc__meter">
          <p class="cc__agent">
            <span>{copy.agent}</span>
            <span class="cc__agent-mode" data-cc-mode></span>
          </p>
          <div class="cc__dial" role="img" data-cc-dial aria-label={`${copy.prompt.stepLabel} 1`}>
            <svg viewBox="0 0 186 186" fill="none" aria-hidden="true">
              <path d="M0 93h186M93 0v186" stroke="#3f4245" />
              <circle cx="93" cy="93" r="80" stroke="#3f4245" />
              <circle cx="93" cy="93" r="73" stroke="#5c5e5f" stroke-width="4" />
              <circle class="cc__dial-progress" cx="93" cy="93" r="73" stroke="currentColor" stroke-width="4" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 93 93)" data-cc-dial-progress />
              <circle cx="93" cy="93" r="34" fill="#16191b" stroke="#3f4245" />
            </svg>
            <span data-cc-dial-text>(1/7)</span>
          </div>
        </div>

        <div class="cc__slot cc__slot--bottom" data-cc-slot-bottom>
          <div class="cc__prompt" data-cc-prompt>
            <p class="cc__label" data-cc-label>{copy.prompt.choose}</p>
            <p class="cc__aside" data-cc-aside role="status"></p>

            <label class="sr-only" for="cc-input" data-cc-input-label>{copy.prompt.label}</label>
            <textarea
              id="cc-input"
              class="cc__input"
              rows="1"
              placeholder={copy.prompt.placeholders.idle}
              autocomplete="off"
              autocapitalize="sentences"
              spellcheck="false"
              data-cc-input
              data-arthur-focus="none"></textarea>
          </div>
          <!-- Tablette et desktop : champ libre, toujours visible ; son contenu part avec le message. -->
          <div class="cc__free">
            <p class="cc__label" data-cc-free-label>{copy.prompt.freeChoose}</p>
            <p class="cc__aside" data-cc-free-aside role="status"></p>
            <label class="sr-only" for="cc-free">{copy.prompt.freeLabel}</label>
            <textarea
              id="cc-free"
              class="cc__input"
              rows="1"
              name="extra"
              placeholder={copy.prompt.placeholders.idle}
              autocomplete="off"
              autocapitalize="sentences"
              spellcheck="false"
              data-cc-free
              data-arthur-focus="none"></textarea>
          </div>
        </div>

        <div class="cc__dock">
          <div class="cc__card">
            <a href={bookCallHref} class="cc__pill" target="_blank" rel="noopener noreferrer">
              {copy.actions.bookCall}
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.1" /></svg>
            </a>
          </div>
          <div class="cc__sight" aria-hidden="true"><Fragment set:html={crosshair} /></div>
          <button type="button" class="cc__tile cc__tile--back" data-cc-back disabled>
            <span class="cc__tile-dot"></span>
            {copy.actions.back}
          </button>
          <button type="submit" class="cc__tile cc__tile--submit" data-cc-submit>
            <span class="cc__tile-top">
              <span data-cc-submit-hint>{copy.prompt.enter}</span>
              <svg viewBox="0 0 10 6" fill="none"><path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="1.1" /></svg>
            </span>
            <span data-cc-submit-label>{copy.actions.next}</span>
          </button>
        </div>
      </div>
    </form>
  </div>
</section>

<style is:global>
  .cc {
    --cc-band: 15.25rem;
    --cc-top: 3.75rem;
    --cc-line: #3a3c40;
    --cc-mute: #6c6e73;
    --cc-orange: #ec5f3a;
    position: relative;
    padding: var(--cc-top) 0.75rem 3rem;
    background: var(--color-bg);
    color: var(--color-white);
  }

  /* Bande sombre du haut, avec ses filets verticaux. */
  .cc__band {
    position: absolute;
    inset: 0 0 auto;
    height: var(--cc-band);
    background-color: var(--color-black);
    background-image:
      repeating-linear-gradient(to right, transparent 0 calc(100% / 8 - 1px), #2a2c2f calc(100% / 8 - 1px) calc(100% / 8)),
      repeating-linear-gradient(to right, transparent 0 calc(100% / 8 + 0.8rem), #232528 calc(100% / 8 + 0.8rem) calc(100% / 8 + 0.8rem + 3px), transparent calc(100% / 8 + 0.8rem + 3px) 200%);
    background-position: -1.5rem 0;
  }

  .cc__grid {
    position: relative;
    display: grid;
    gap: 0;
    max-width: 82.5rem;
    margin-inline: auto;
  }

  /* ---------- Colonne Arthur ---------- */

  .cc__side {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cc__arthur {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 1rem 0.25rem 1.25rem;
  }

  .cc__bubble {
    position: relative;
  }

  .cc__bubble .arthur-bubble {
    --arthur-size: 5rem;
    box-shadow: none;
  }

  .cc__bubble::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #3ee06b;
    box-shadow: 0 0 0 2px var(--color-black);
  }

  .cc__name,
  .cc__rail {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
  }

  .cc__name {
    letter-spacing: 0.22em;
  }

  .cc__rail {
    display: none;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.1rem;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-black);
    text-align: center;
  }

  .cc__rail-tick {
    width: 1px;
    height: 2.4rem;
    background: var(--color-white);
  }

  .cc__compass {
    display: block;
    width: 100%;
    color: var(--color-white);
  }

  .cc__compass svg {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: -1px;
  }

  .cc__compass svg [fill="white"] {
    fill: none;
  }

  /* ---------- Panneau principal ---------- */

  .cc__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 0.75rem 0.75rem;
    border-radius: 0 0 10px 10px;
    background: var(--color-black);
  }

  .cc__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
  }

  .cc__dialog {
    min-width: 0;
    max-width: 29rem;
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .cc__prev {
    display: none;
    margin-bottom: 0.9rem;
    color: var(--cc-mute);
  }

  .cc__question {
    min-height: 2.6em;
  }

  .cc__caret {
    display: inline-block;
    width: 0.5em;
    height: 0.95em;
    margin-left: 0.4em;
    background: currentColor;
    vertical-align: -0.12em;
    animation: cc-caret 1.1s steps(2, start) infinite;
  }

  @keyframes cc-caret {
    to {
      visibility: hidden;
    }
  }

  .cc__back-round {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 999px;
    background: var(--color-button-white);
    color: var(--color-black);
    cursor: pointer;
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cc__back-round svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .cc__back-round:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .cc__stage {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
  }

  .cc__main {
    flex: 1;
    min-width: 0;
  }

  .cc__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cc__chips:empty {
    display: none;
  }

  .cc__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    background: var(--color-button-white);
    color: var(--color-black);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    animation: cc-pop 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--i, 0) * 45ms);
  }

  .cc__chip svg {
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
  }

  .cc__chip[aria-pressed="true"] {
    background: var(--cc-orange);
  }

  .cc__chip[data-copied]::after {
    content: attr(data-copied-label);
    font-size: 0.6875rem;
    opacity: 0.6;
  }

  @media (hover: hover) {
    .cc__chip:hover {
      transform: translateY(-2px);
    }
  }

  @keyframes cc-pop {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
  }

  .cc__recap {
    display: grid;
    margin-top: 1.25rem;
  }

  .cc__recap:empty {
    display: none;
  }

  .cc__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    width: 100%;
    max-width: 44rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--cc-line);
    text-align: left;
    cursor: pointer;
    animation: cc-pop 0.55s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(120ms + var(--i, 0) * 60ms);
  }

  .cc__row:last-child {
    border-bottom: 1px solid var(--cc-line);
  }

  .cc__row-key {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cc-mute);
  }

  .cc__row-value {
    display: -webkit-box;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .cc__row-edit {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--cc-mute);
    transition: color 0.2s ease;
  }

  .cc__row:hover .cc__row-edit,
  .cc__row:focus-visible .cc__row-edit {
    color: var(--color-white);
  }

  .cc__noscript {
    margin-top: 1rem;
    color: var(--color-white);
  }

  .cc__noscript a {
    text-decoration: underline;
  }

  /* Égaliseur : barres au repos réduites au minimum, animées quand Arthur parle. */
  .cc__ruler {
    order: 9;
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-end;
    justify-content: space-between;
    height: 1.5rem;
  }

  .cc__ruler i {
    --v: 0.14;
    width: 1px;
    height: 100%;
    background: #4a4c50;
    transform: scaleY(var(--v));
    transform-origin: bottom;
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.4s ease;
  }

  .cc[data-speaking] .cc__ruler i {
    background: var(--color-white);
    transition: background-color 0.2s ease;
  }

  .cc__ruler b {
    width: 3px;
    height: 100%;
    background: #5c5e5f;
  }

  /* Champ de réponse sous la question (tablette et desktop), au même endroit que les puces. */
  /* Contient les marges de ses enfants : sa hauteur mesurée est la vraie place occupée. */
  .cc__prompt {
    display: flow-root;
  }

  .cc__slot--top:empty {
    display: none;
  }

  /* Champ libre : réservé à la tablette et au desktop (en mobile, le prompt unique joue ce rôle). */
  .cc__free {
    display: none;
  }

  @media (min-width: 640px) {
    .cc__free {
      display: block;
    }

    /* Le champ du haut n'apparaît qu'aux étapes de saisie. */
    .cc:not([data-mode="type"]) .cc__slot--top {
      display: none;
    }
  }

  .cc__slot--top {
    max-width: 44rem;
  }

  .cc__slot--top .cc__prompt {
    display: flex;
    flex-direction: column;
  }

  .cc__slot--top .cc__label {
    margin-bottom: 0.7rem;
  }

  .cc__slot--top .cc__aside {
    order: 2;
    min-height: 0;
    margin: 0.6rem 0 0;
  }

  .cc__slot--top .cc__aside:empty {
    display: none;
  }

  /* Puces qui s'effacent pendant le passage à la saisie (copie posée par-dessus). */
  .cc__ghost {
    position: absolute;
    z-index: 2;
    margin: 0;
    pointer-events: none;
  }

  .cc__ghost .cc__chip {
    animation: none;
  }

  /* ---------- Prompt ---------- */

  .cc__composer {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 1rem;
    border-top: 1px solid var(--cc-line);
  }

  /* Sur mobile, agent et compteur cèdent la place : question et réponse restent visibles ensemble. */
  .cc__meter {
    display: none;
  }

  .cc__agent {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.2rem 0.75rem;
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .cc__agent-mode {
    color: var(--cc-mute);
    font-weight: 400;
  }

  .cc__agent-mode:empty {
    display: none;
  }

  .cc__dial {
    position: relative;
    width: 4.75rem;
    aspect-ratio: 1;
    flex: none;
    color: var(--color-white);
  }

  .cc__dial svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cc__dial-progress {
    transition: stroke-dasharray 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cc__dial span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .cc__label {
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--cc-mute);
  }

  .cc__aside {
    min-height: 1.4em;
    margin: 0.35rem 0 0.7rem;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .cc__aside[data-tone="error"] {
    color: var(--color-err);
  }

  .cc__aside a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cc__input {
    display: block;
    width: 100%;
    max-height: 11rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid #5c5e5f;
    border-radius: 8px;
    background: transparent;
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0;
    resize: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cc__input::placeholder {
    color: var(--cc-mute);
    opacity: 1;
  }

  .cc__input:focus,
  .cc__input:focus-visible {
    outline: none;
    border-color: var(--color-white);
    box-shadow: 0 0 0 3px rgb(244 241 248 / 0.12);
  }

  .cc__input[aria-invalid="true"] {
    border-color: var(--color-err);
  }

  .cc__input[aria-invalid="true"]::placeholder {
    color: var(--color-err);
  }

  .cc__input:disabled {
    border-style: dashed;
    cursor: not-allowed;
  }

  .cc__dock {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .cc__card {
    order: 3;
    grid-column: 1 / -1;
    display: flex;
    border-radius: 8px;
    background: var(--color-button-white);
    color: var(--color-black);
  }

  .cc__pill {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.6rem;
    margin: 0.35rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: #fff;
    box-shadow:
      inset 0 2px 5px rgb(22 25 27 / 0.16),
      inset 0 -1px 0 rgb(22 25 27 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    cursor: pointer;
    transition: box-shadow 0.25s ease;
  }

  .cc__pill svg {
    width: 0.7rem;
    height: 0.7rem;
    flex: none;
  }

  .cc__pill:hover {
    box-shadow:
      inset 0 3px 9px rgb(22 25 27 / 0.3),
      inset 0 -1px 0 rgb(22 25 27 / 0.04);
  }

  .cc__sight {
    display: none;
  }

  .cc__tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    background: var(--color-button-white);
    color: var(--color-black);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
