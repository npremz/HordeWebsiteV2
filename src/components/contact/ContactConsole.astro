  /* ---------- Mobile : en-tête sur la bande, Arthur à gauche de la question ---------- */

  @media (max-width: 639px) {
    .cc {
      /* La bande se lit comme une grille de 3 colonnes ; Arthur occupe la première. */
      --cc-gutter: 0.65rem;
      --cc-col: calc((100cqw - 1.5rem - 2 * var(--cc-gutter)) / 3);
      /* Question : 2 lignes grises en haut, jusqu'à 3 lignes blanches en bas. */
      --cc-q-line: 1.275rem;
      --cc-q-gap: 0.6rem;
      --cc-dialog-h: calc(5 * var(--cc-q-line) + var(--cc-q-gap));
      --cc-head-top: 1.1rem;
      --cc-band: calc(var(--cc-top) + var(--cc-head-top) + var(--cc-dialog-h) + 0.6rem);
      container-type: inline-size;
    }

    /* Filets aux bords des colonnes ; liseré en pied de bande seulement hors du panneau (le texte d'Arthur reste sur fond noir). */
    .cc__band {
      --cc-rule: linear-gradient(#26282b, #26282b);
      --cc-foot: linear-gradient(#2b2c2e, #2b2c2e);
      background-image:
        var(--cc-rule), var(--cc-rule), var(--cc-rule), var(--cc-rule), var(--cc-rule), var(--cc-rule),
        var(--cc-foot), var(--cc-foot);
      background-repeat: no-repeat;
      background-size:
        1px 100%, 1px 100%, 1px 100%, 1px 100%, 1px 100%, 1px 100%,
        0.75rem 0.55rem, 0.75rem 0.55rem;
      background-position:
        0.75rem 0,
        calc(0.75rem + var(--cc-col) - 1px) 0,
        calc(0.75rem + var(--cc-col) + var(--cc-gutter)) 0,
        calc(0.75rem + 2 * var(--cc-col) + var(--cc-gutter) - 1px) 0,
        calc(0.75rem + 2 * var(--cc-col) + 2 * var(--cc-gutter)) 0,
        calc(100% - 0.75rem - 1px) 0,
        0 100%,
        100% 100%;
    }

    /* Arthur et le panneau partagent la première ligne de la grille. */
    .cc__grid {
      grid-template-columns: var(--cc-col) minmax(0, 1fr);
