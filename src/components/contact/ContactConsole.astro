</style>

<script>
  import { whenArthurReady } from "../../lib/arthur/mount";
  import type { Arthur } from "../../lib/arthur/arthur";
  import type { ContactCopy } from "./copy";

  type Intent = "project" | "team" | "word";
  type StepId = "intent" | "besoin" | "objectif" | "nom" | "societe" | "email" | "confirm" | "done";
  type TextStep = "objectif" | "nom" | "societe" | "email";

  interface Config {
    copy: ContactCopy;
    email: string;
    cultureHref: string;
    pagePath: string;
    needs: { value: string; label: string }[];
    errors: { required: string; invalidEmail: string; maxLength: string };
  }

  const FLOWS: Record<Intent, StepId[]> = {
    project: ["intent", "besoin", "objectif", "nom", "societe", "email", "confirm"],
    team: ["intent", "objectif", "nom", "email", "confirm"],
    word: ["intent", "objectif", "nom", "societe", "email", "confirm"],
  };
  const MAX_LENGTHS: Record<TextStep, number> = { objectif: 2000, nom: 100, societe: 200, email: 254 };
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const COPY_ICON =
    '<svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="4.5" y="4.5" width="8" height="8" rx="2" stroke="currentColor"/><path d="M9.5 2.5a1 1 0 0 0-1-1h-5a2 2 0 0 0-2 2v5a1 1 0 0 0 1 1" stroke="currentColor" stroke-linecap="round"/></svg>';

  let teardown: (() => void) | null = null;

  function initContactConsole() {
    teardown?.();
    teardown = null;

    const root = document.querySelector<HTMLElement>("[data-contact-console]");
    if (!root) return;

    const config = JSON.parse(root.dataset.config ?? "{}") as Config;
    const { copy } = config;
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const form = $<HTMLFormElement>("[data-cc-form]");
    const prevEl = $("[data-cc-prev]");
    const questionEl = $("[data-cc-question]");
    const liveEl = $("[data-cc-live]");
    const chipsEl = $("[data-cc-chips]");
    const recapEl = $("[data-cc-recap]");
    const labelEl = $("[data-cc-label]");
    const asideEl = $("[data-cc-aside]");
    const freeInput = $<HTMLTextAreaElement>("[data-cc-free]");
    const freeLabel = $("[data-cc-free-label]");
    const freeAside = $("[data-cc-free-aside]");
    const modeEl = $("[data-cc-mode]");
    const input = $<HTMLTextAreaElement>("[data-cc-input]");
    const inputLabel = $("[data-cc-input-label]");
    const submitButton = $<HTMLButtonElement>("[data-cc-submit]");
    const submitLabel = $("[data-cc-submit-label]");
    const submitHint = $("[data-cc-submit-hint]");
    const dial = $("[data-cc-dial]");
    const dialText = $("[data-cc-dial-text]");
    const dialProgress = root.querySelector<SVGCircleElement>("[data-cc-dial-progress]")!;
    const backButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cc-back]"));
    const ticks = Array.from(root.querySelectorAll<HTMLElement>("[data-cc-ruler] i"));
    const IDLE_LEVEL = 0.14;
    const levels = ticks.map(() => IDLE_LEVEL);

    const controller = new AbortController();
    const { signal } = controller;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    let arthur: Arthur | null = null;
    let typingFrame = 0;

    const state = {
      intent: null as Intent | null,
      step: "intent" as StepId,
      besoin: "",
      answers: { objectif: "", nom: "", societe: "", email: "" } as Record<TextStep, string>,
      societeSeen: false,
      /** Message additionnel, facultatif, saisi à la confirmation. */
      extra: "",
      status: "idle" as "idle" | "sending" | "error" | "done",
      lastQuestion: copy.greeting,
    };

    teardown = () => {
      controller.abort();
      window.cancelAnimationFrame(typingFrame);
    };

    /* ---------- Helpers ---------- */

    const flow = () => FLOWS[state.intent ?? "project"];
    const isTextStep = (step: StepId): step is TextStep => step in MAX_LENGTHS;
    const firstName = () => state.answers.nom.trim().split(/\s+/)[0] ?? "";
    const fill = (text: string) =>
      text
        .replace("{name}", firstName())
        .replace(/\s+,/g, ",")
        .replace(/,\s*\./g, ".");

    const questionFor = (step: StepId): string => {
      const q = copy.questions;
      switch (step) {
        case "intent":
          return q.intent;
        case "besoin":
          return q.besoin;
        case "objectif":
          return state.intent === "team" ? q.objectifTeam : state.intent === "word" ? q.objectifWord : q.objectifProject;
        case "nom":
          return q.nom;
        case "societe":
          return fill(q.societe);
        case "email":
          return q.email;
        case "confirm":
          return state.status === "sending" ? q.sending : q.confirm;
        case "done":
          return fill(q.done);
      }
    };

    const fieldLabel = (step: StepId): string => {
      if (step === "objectif") return state.intent === "project" ? copy.fields.objectif : copy.fields.message;
      return copy.fields[step as keyof typeof copy.fields] ?? "";
    };

    const isAnswered = (step: StepId): boolean => {
      switch (step) {
        case "intent":
          return state.intent !== null;
        case "besoin":
          return state.besoin !== "";
        case "societe":
          return state.societeSeen;
        case "objectif":
        case "nom":
        case "email":
          return state.answers[step].trim() !== "";
        default:
          return false;
      }
    };

    /** Première question encore sans réponse, sinon la confirmation. */
    const nextOpenStep = (): StepId => flow().find((step) => step !== "confirm" && !isAnswered(step)) ?? "confirm";

    const react = (name: Parameters<Arthur["react"]>[0]) => arthur?.react(name);

    /** Rythme de la parole d'Arthur (ms). */
    const CHAR_MS = 28;
    const SENTENCE_PAUSE_MS = 450;
    const COMMA_PAUSE_MS = 160;
    /** Temps de réaction avant chaque nouvelle phrase d'Arthur. */
    const REPLY_DELAY_MS = 320;
    /** Au chargement : le temps de parcourir la page avant la première question. */
    const FIRST_DELAY_MS = 1500;

    /** Égaliseur : les barres s'agitent au rythme des lettres ; energy 0 = retour au repos (pause). */
    const speak = (now: number, char: string, energy: number) => {
      const code = char.charCodeAt(0) || 0;
      ticks.forEach((tick, index) => {
        const wave = 0.5 + 0.5 * Math.sin(now * 0.017 + index * 1.7);
        const wobble = 0.55 + 0.45 * Math.sin(now * 0.029 + index * 0.83 + code);
        const target = IDLE_LEVEL + (1 - IDLE_LEVEL) * energy * Math.pow(wave, 0.6) * (0.4 + 0.6 * wobble);
        levels[index] += (target - levels[index]) * 0.45;
        tick.style.setProperty("--v", levels[index].toFixed(3));
      });
    };

    const silence = () => {
      delete root.dataset.speaking;
      ticks.forEach((tick, index) => {
        levels[index] = IDLE_LEVEL;
        tick.style.removeProperty("--v");
      });
    };

    /**
     * Arthur « parle » : machine à écrire calée sur le temps écoulé, avec un temps de réaction
     * au départ, une pause après chaque phrase et une plus courte après les virgules.
     */
    const type = (target: HTMLElement, text: string, delay = REPLY_DELAY_MS) => {
      window.cancelAnimationFrame(typingFrame);
      silence();
      if (reducedMotion) {
        target.textContent = text;
        return;
      }
      // Instant d'apparition de chaque lettre.
      const times: number[] = [];
      let clock = delay;
      for (let i = 0; i < text.length; i++) {
        clock += CHAR_MS;
        times.push(clock);
        const next = text.charAt(i + 1);
        if (next === " " || next === "\u00a0") {
          if (/[.!?…]/.test(text.charAt(i))) clock += SENTENCE_PAUSE_MS;
          else if (/[,;:]/.test(text.charAt(i))) clock += COMMA_PAUSE_MS;
        }
      }

      const start = performance.now();
      let count = 0;
      target.textContent = "";
      const tick = (now: number) => {
        const elapsed = now - start;
        while (count < text.length && times[count] <= elapsed) count++;
        target.textContent = text.slice(0, count);
        if (count >= text.length) {
          silence();
          return;
        }
        if (elapsed >= delay) {
          root.dataset.speaking = "";
          const char = text.charAt(Math.max(count - 1, 0));
          const pausing = count > 0 && elapsed - times[count - 1] > CHAR_MS * 2;
          speak(now, char, pausing ? 0 : /[\s.,;:!?…’'-]/.test(char) ? 0.3 : 1);
        }
        typingFrame = window.requestAnimationFrame(tick);
      };
      typingFrame = window.requestAnimationFrame(tick);
    };

    /** Tablette et desktop : deux champs. Le message s'affiche près de celui qui est concerné. */
    const isWide = () => window.matchMedia("(min-width: 640px)").matches;
    const setAside = (text: string, tone: "info" | "error" = "info", html = false) => {
      asideEl.textContent = "";
      freeAside.textContent = "";
      const target = isWide() && !isTextStep(state.step) ? freeAside : asideEl;
      target.dataset.tone = tone;
      if (html) target.innerHTML = text;
      else target.textContent = text;
    };

    const resizeField = (field: HTMLTextAreaElement) => {
      field.style.height = "auto";
      field.style.height = `${field.scrollHeight + 2}px`;
    };

    const resizeInput = () => {
      input.style.height = "auto";
      input.style.height = `${input.scrollHeight + 2}px`;
    };

    /* ---------- Rendu ---------- */

    const chip = (label: string, index: number, attrs: Record<string, string> = {}) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "cc__chip";
      button.style.setProperty("--i", String(index));
      button.textContent = label;
      Object.entries(attrs).forEach(([key, value]) => button.setAttribute(key, value));
      return button;
    };

    const renderChips = () => {
      chipsEl.replaceChildren();
      if (state.step === "intent") {
        const intents: [string, string][] = [
          ["project", copy.intents.project],
          ["team", copy.intents.team],
          ["culture", copy.intents.culture],
          ["word", copy.intents.word],
        ];
        intents.forEach(([value, label], index) => {
          const button = chip(label, index, { "data-cc-intent": value });
          if (state.intent === value) button.setAttribute("aria-pressed", "true");
          chipsEl.append(button);
        });
        const write = chip(`${copy.intents.write}${config.email}`, intents.length, {
          "data-copy-text": config.email,
          "data-copied-label": copy.actions.copied,
          "aria-label": `${copy.actions.copyEmail} ${config.email}`,
        });
        write.insertAdjacentHTML("beforeend", COPY_ICON);
        chipsEl.append(write);
      } else if (state.step === "besoin") {
        config.needs.forEach((need, index) => {
          const button = chip(need.label, index, { "data-cc-need": need.value });
          if (state.besoin === need.value) button.setAttribute("aria-pressed", "true");
          chipsEl.append(button);
        });
      }
    };

    const renderRecap = () => {
      recapEl.replaceChildren();
      // Récapitulatif modifiable seulement à la confirmation : avant, le bouton Retour suffit.
      if (state.step !== "confirm") return;
      const rows: [StepId, string, string][] = [];
      flow().forEach((step) => {
        if (step === state.step || step === "confirm" || !isAnswered(step)) return;
        let value = "";
        if (step === "intent") value = state.intent ? copy.intentLabels[state.intent] : "";
        else if (step === "besoin") value = config.needs.find((need) => need.value === state.besoin)?.label ?? "";
        else if (isTextStep(step)) value = state.answers[step].trim();
        if (!value) return;
        rows.push([step, fieldLabel(step), value]);
      });
      rows.forEach(([step, label, value], index) => {
        const row = document.createElement("button");
        row.type = "button";
        row.className = "cc__row";
        row.style.setProperty("--i", String(index));
        row.dataset.ccEdit = step;
        row.setAttribute("aria-label", `${copy.actions.edit} — ${label} : ${value}`);
        const dt = document.createElement("span");
        dt.className = "cc__row-key";
        dt.textContent = label;
        const dd = document.createElement("span");
        dd.className = "cc__row-value";
        dd.textContent = value;
        const edit = document.createElement("span");
        edit.className = "cc__row-edit";
        edit.textContent = copy.actions.edit;
        row.append(dt, dd, edit);
        recapEl.append(row);
      });
    };

    const renderProgress = () => {
      const steps = flow();
      const total = steps.length;
      const index = state.step === "done" ? total : Math.max(steps.indexOf(state.step), 0);
      const ratio = state.step === "done" ? 1 : index / (total - 1);
      const current = Math.min(index + 1, total);
      dialText.textContent = `(${current}/${total})`;
      dial.setAttribute("aria-label", `${copy.prompt.stepLabel} ${current} / ${total}`);
      dialProgress.setAttribute("stroke-dasharray", `${ratio * 100} 100`);
    };

    /** Le message additionnel est joint à l'objectif : il partage sa limite de longueur. */
    const objectifBody = () => {
      const tag = state.intent && state.intent !== "project" ? `${copy.intentTags[state.intent]} ` : "";
      return `${tag}${state.answers.objectif}`;
    };
    const extraBlock = (extra: string) => (extra ? `\n\n${copy.extraHeading}\n${extra}` : "");
    const extraMax = () => Math.max(MAX_LENGTHS.objectif - objectifBody().length - extraBlock(" ").length + 1, 0);

    const renderPrompt = (focus: boolean) => {
      const { step } = state;
      const text = isTextStep(step);
      const sending = state.status === "sending";
      const placeholders = copy.prompt.placeholders;

      input.removeAttribute("aria-invalid");
      const confirming = step === "confirm";
      input.disabled = sending || step === "done";
      input.name = text ? step : confirming ? "extra" : "message";
      input.value = text ? state.answers[step] : confirming ? state.extra : "";
      input.maxLength = text ? MAX_LENGTHS[step] : confirming ? extraMax() : MAX_LENGTHS.objectif;
      input.placeholder = text ? placeholders[step] : placeholders.idle;
      input.setAttribute("inputmode", step === "email" ? "email" : "text");
      input.setAttribute("autocomplete", step === "email" ? "email" : step === "nom" ? "name" : step === "societe" ? "organization" : "off");
      input.setAttribute("autocapitalize", step === "email" ? "none" : "sentences");
      input.setAttribute("aria-required", String(text && step !== "societe"));
      resizeInput();

      let label = copy.prompt.choose;
      if (text) {
        const required = step !== "societe";
        label = `${fieldLabel(step)}${required ? "*" : ` — ${copy.prompt.optional.toLowerCase()}`}`;
        if (step === "objectif" && finePointer) label += ` · ${copy.prompt.hintMultiline}`;
      } else if (step === "confirm") label = copy.prompt.review;
      else if (step === "done") label = copy.prompt.done;
      labelEl.textContent = label;
      inputLabel.textContent = text ? fieldLabel(step) : copy.prompt.label;

      // Champ libre (tablette et desktop) : toujours là, son contenu part avec le message.
      freeInput.disabled = sending || step === "done";
      freeInput.value = state.extra;
      freeInput.maxLength = text || confirming ? extraMax() : MAX_LENGTHS.objectif;
      freeLabel.textContent =
        step === "done"
          ? copy.prompt.done
          : confirming
            ? copy.prompt.review
            : text
              ? copy.prompt.freeExtra
              : copy.prompt.freeChoose;
      resizeField(freeInput);

      modeEl.textContent = state.intent ? `/ ${copy.intentLabels[state.intent]}` : "";

      let action = copy.actions.next;
      if (step === "societe" && !input.value.trim()) action = copy.actions.skip;
      if (step === "confirm") action = sending ? copy.actions.sending : copy.actions.send;
      if (step === "done") action = copy.actions.again;
      submitLabel.textContent = action;
      submitHint.textContent = step === "done" ? "" : copy.prompt.enter;
      submitButton.disabled = sending;

      const canGoBack = !sending && step !== "done" && flow().indexOf(step) > 0;
      backButtons.forEach((button) => (button.disabled = !canGoBack));

      if (focus && text && !input.disabled) input.focus({ preventScroll: true });
    };

    const render = (options: { focus?: boolean; keepAside?: boolean; delay?: number } = {}) => {
      const question = questionFor(state.step);
      root.dataset.step = state.step;
      root.dataset.mode = modeOf(state.step);
      root.dataset.status = state.status;
      prevEl.textContent = state.lastQuestion;
      type(questionEl, question, options.delay);
      liveEl.textContent = question;
      if (!options.keepAside) setAside("");
      renderChips();
      renderRecap();
      renderProgress();
      placePrompt();
      renderPrompt(options.focus ?? true);
    };

    /* ---------- Transitions et cadrage ---------- */

    type Mode = "choose" | "type" | "review";
    const modeOf = (step: StepId): Mode =>
      isTextStep(step) ? "type" : step === "intent" || step === "besoin" ? "choose" : "review";
    const composer = $(".cc__composer");
    const promptEl = $("[data-cc-prompt]");
    const slotTop = $("[data-cc-slot-top]");
    const slotBottom = $("[data-cc-slot-bottom]");
    const wide = window.matchMedia("(min-width: 640px)");
    /**
     * Tablette et desktop : le champ de l'étape vit sous la question (visible aux étapes de saisie),
     * le champ libre reste en bas. Mobile : un seul prompt, en bas.
     */
    const placePrompt = () => {
      if (wide.matches) {
        if (promptEl.parentElement !== slotTop) slotTop.append(promptEl);
      } else if (promptEl.parentElement !== slotBottom) {
        slotBottom.prepend(promptEl);
      }
    };
    const arthurEl = $(".cc__arthur");
    const dialogEl = $(".cc__dialog");
    const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
    const MARGIN = 12;
    let revealUntil = 0;

    /**
     * Cadre la question et la zone utile dans la partie visible de l'écran (clavier compris,
     * via visualViewport). Arthur est gardé au-dessus de la question quand la place le permet.
     */
    const reveal = (smooth = true) => {
      const mode = modeOf(state.step);
      const bottomEl =
        mode === "type" ? input : mode === "review" ? submitButton : (chipsEl.lastElementChild as HTMLElement | null) ?? input;
      const viewport = window.visualViewport;
      const viewTop = viewport?.offsetTop ?? 0;
      const viewHeight = viewport?.height ?? window.innerHeight;
      const bottom = bottomEl.getBoundingClientRect().bottom - viewTop;
      const fits = (el: Element) => bottom - (el.getBoundingClientRect().top - viewTop) + 2 * MARGIN <= viewHeight;
      const topEl = [arthurEl, dialogEl].find(fits) ?? dialogEl;
      const top = topEl.getBoundingClientRect().top - viewTop;

      let delta = 0;
      if (top < MARGIN) delta = top - MARGIN;
      else if (bottom > viewHeight - MARGIN) delta = Math.min(bottom - (viewHeight - MARGIN), top - MARGIN);
      if (!fits(topEl) && mode === "type") delta = bottom - (viewHeight - MARGIN);
      if (Math.abs(delta) < 4) return;

      const behavior: ScrollBehavior = smooth && !reducedMotion ? "smooth" : "auto";
      const lenis = (window as unknown as { lenis?: { scrollTo(target: number, options?: object): void } }).lenis;
      if (lenis) lenis.scrollTo(window.scrollY + delta, { immediate: behavior === "auto" });
      else window.scrollBy({ top: delta, behavior });
    };

    /**
     * Applique un changement d'étape avec transition : les puces s'effacent, le prompt glisse
     * à sa nouvelle place (FLIP), le champ s'allume quand on passe à la saisie.
     */
    /** Copie figée d'un bloc qui disparaît, posée par-dessus le panneau le temps de s'effacer. */
    const capture = (el: HTMLElement, panelRect: DOMRect) =>
      !reducedMotion && el.childElementCount
        ? { el, clone: el.cloneNode(true) as HTMLElement, rect: el.getBoundingClientRect(), panelRect }
        : null;

    const fadeOut = (ghost: NonNullable<ReturnType<typeof capture>>) => {
      const { clone, rect, panelRect } = ghost;
      clone.className = `${clone.className} cc__ghost`;
      clone.removeAttribute("data-cc-chips");
      clone.removeAttribute("data-cc-recap");
      clone.setAttribute("aria-hidden", "true");
      clone.inert = true;
      Object.assign(clone.style, {
        left: `${rect.left - panelRect.left}px`,
        top: `${rect.top - panelRect.top}px`,
        width: `${rect.width}px`,
      });
      form.append(clone);
      clone
        .animate(
          [
            { opacity: 1, transform: "none", filter: "blur(0)" },
            { opacity: 0, transform: "translateY(-0.9rem) scale(0.98)", filter: "blur(3px)" },
          ],
          { duration: 340, easing: EASE, fill: "forwards" },
        )
        .finished.then(() => clone.remove(), () => clone.remove());
    };

    const transition = (update: () => void) => {
      const fromMode = modeOf(state.step);
      const fromTop = composer.getBoundingClientRect().top;
      const panelRect = form.getBoundingClientRect();
      const ghosts = [capture(chipsEl, panelRect), capture(recapEl, panelRect)];

      update();

      const toMode = modeOf(state.step);
      const showTop = wide.matches && toMode === "type" && fromMode !== "type";
      const delta = fromTop - composer.getBoundingClientRect().top;
      revealUntil = performance.now() + 2500;
      reveal();
      if (reducedMotion) return;

      // Un bloc qui se vide s'efface en douceur ; un bloc remplacé (puces → autres puces) apparaît simplement.
      ghosts.forEach((ghost) => {
        if (ghost && ghost.el.childElementCount === 0) fadeOut(ghost);
      });

      if (showTop) {
        promptEl.animate(
          [
            { opacity: 0, transform: "translateY(0.6rem)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 460, delay: 120, easing: EASE, fill: "backwards" },
        );
      }

      if (Math.abs(delta) > 2) {
        composer.animate([{ transform: `translateY(${delta}px)` }, { transform: "none" }], {
          duration: 560,
          easing: EASE,
        });
      }

      if (toMode === "type") {
        const arriving = fromMode !== "type";
        labelEl.animate(
          [
            { opacity: 0, transform: "translateY(0.4rem)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 420, delay: arriving ? 160 : 0, easing: EASE, fill: "backwards" },
        );
        if (arriving) {
          input.animate(
            [
              { boxShadow: "0 0 0 0 rgb(236 95 58 / 0.55)", borderColor: "#ec5f3a" },
              { boxShadow: "0 0 0 0.6rem rgb(236 95 58 / 0)", borderColor: "#f4f1f8" },
            ],
            { duration: 750, delay: 220, easing: "ease-out" },
          );
        }
      }
    };

    const goTo = (step: StepId, options: { focus?: boolean; keepAside?: boolean } = {}) => {
      transition(() => {
        if (step !== state.step) state.lastQuestion = questionFor(state.step);
        state.step = step;
        if (step === "societe") state.societeSeen = true;
        render(options);
      });
    };

    const advance = (options: { keepAside?: boolean } = {}) => goTo(nextOpenStep(), options);

    /* ---------- Actions ---------- */

    const chooseIntent = (intent: Intent) => {
      state.intent = intent;
      if (intent !== "project") state.besoin = "";
      react("like");
      advance();
    };

    const fail = (message: string, reaction: "oops" | "no") => {
      input.setAttribute("aria-invalid", "true");
      setAside(message, "error");
      react(reaction);
      input.focus({ preventScroll: true });
    };

    const submitText = (step: TextStep) => {
      const value = input.value.trim();
      const max = MAX_LENGTHS[step];
      if (!value && step !== "societe") return fail(config.errors.required, "oops");
      if (value.length > max) return fail(config.errors.maxLength.replace("{max}", String(max)), "no");
      if (step === "email" && !EMAIL_PATTERN.test(value)) return fail(config.errors.invalidEmail, "no");

      state.answers[step] = value;
      if (step === "societe" && !value) {
        react("wink");
        setAside(copy.asides.skipped);
        return advance({ keepAside: true });
      }
      react(step === "email" ? "yes" : step === "nom" ? "hello" : "like");
      advance();
    };

    const send = async () => {
      if (state.status === "sending" || !state.intent) return;
      state.status = "sending";
      arthur?.releaseLook();
      react("thinking");
      render({ focus: false });

      const payload = {
        besoin: state.intent === "project" ? state.besoin : "autre",
        objectif: `${objectifBody()}${extraBlock(state.extra.trim())}`.slice(0, MAX_LENGTHS.objectif),
        nom: state.answers.nom,
        email: state.answers.email,
        societe: state.answers.societe,
        source: { type: "contact-page", pagePath: config.pagePath },
      };

      let ok = false;
      try {
        const response = await fetch("/api/contact/", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          signal,
        });
        ok = response.ok;
      } catch {
        ok = false;
      }
      if (signal.aborted) return;

      react("calm");
      if (ok) {
        state.status = "done";
        react("success");
        goTo("done", { focus: false });
        submitButton.focus({ preventScroll: true });
        return;
      }
      state.status = "error";
      react("error");
      render({ focus: false });
      setAside(
        `${copy.questions.failed} <a href="mailto:${config.email}">${config.email}</a>`,
        "error",
        true,
      );
    };

    const restart = () => {
      react("hello");
      transition(() => {
        state.intent = null;
        state.besoin = "";
        state.answers = { objectif: "", nom: "", societe: "", email: "" };
        state.extra = "";
        state.societeSeen = false;
        state.status = "idle";
        state.lastQuestion = copy.greeting;
        state.step = "intent";
        render({ focus: false });
      });
    };

    const submit = () => {
      const { step } = state;
      if (state.status === "sending") return;
      if (step === "done") return restart();
      if (step === "confirm") return void send();
      if (isTextStep(step)) return submitText(step);

      // Étapes à puces : un texte libre (champ libre en desktop, prompt en mobile) vaut réponse.
      const fromFree = isWide();
      const value = (fromFree ? freeInput : input).value.trim();
      if (!value) {
        setAside(copy.prompt.choose, "error");
        react("oops");
        chipsEl.querySelector<HTMLElement>("button")?.focus({ preventScroll: true });
        return;
      }
      if (step === "intent") state.intent = "word";
      else state.besoin = "autre";
      state.answers.objectif = value.slice(0, MAX_LENGTHS.objectif);
      if (fromFree) state.extra = "";
      react("like");
      advance();
    };

    /* ---------- Événements ---------- */

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        submit();
      },
      { signal },
    );

    input.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Enter" || event.isComposing) return;
        const multiline = ["objectif", "intent", "besoin", "confirm"].includes(state.step);
        if (event.shiftKey && multiline) return;
        event.preventDefault();
        submit();
      },
      { signal },
    );

    input.addEventListener(
      "input",
      () => {
        resizeInput();
        if (state.step === "confirm") state.extra = input.value;
        if (input.getAttribute("aria-invalid")) {
          input.removeAttribute("aria-invalid");
          setAside("");
        }
        if (state.step === "societe") {
          submitLabel.textContent = input.value.trim() ? copy.actions.next : copy.actions.skip;
        }
        // Les yeux d'Arthur suivent la saisie.
        const charWidth = parseFloat(getComputedStyle(input).fontSize) * 0.62;
        const lastLine = input.value.split("\n").pop() ?? "";
        const progress = Math.min((lastLine.length * charWidth) / (input.clientWidth || 1), 1);
        arthur?.lookAtElement(input, 0.05 + progress * 0.9);
      },
      { signal },
    );

    input.addEventListener(
      "focus",
      () => {
        arthur?.lookAtElement(input, 0.1);
        react("focus");
      },
      { signal },
    );

    input.addEventListener(
      "blur",
      () => {
        arthur?.releaseLook();
        if (state.status !== "sending") react("calm");
      },
      { signal },
    );

    root.addEventListener(
      "click",
      (event) => {
        const target = (event.target as Element).closest<HTMLElement>(
          "[data-cc-intent],[data-cc-need],[data-cc-edit],[data-cc-back]",
        );
        if (!target || state.status === "sending") return;
        const { ccIntent, ccNeed, ccEdit } = target.dataset;

        if (ccIntent === "culture") {
          react("wink");
          window.location.assign(config.cultureHref);
        } else if (ccIntent) {
          target.setAttribute("aria-pressed", "true");
          chooseIntent(ccIntent as Intent);
        } else if (ccNeed) {
          target.setAttribute("aria-pressed", "true");
          state.besoin = ccNeed;
          react("like");
          advance();
        } else if (ccEdit) {
          if (state.status === "error") state.status = "idle";
          goTo(ccEdit as StepId);
        } else if (target.hasAttribute("data-cc-back")) {
          const steps = flow();
          const index = steps.indexOf(state.step);
          if (state.status === "error") state.status = "idle";
          if (index > 0) goTo(steps[index - 1]);
        }
      },
      { signal },
    );

    root.addEventListener(
      "horde:copied",
      () => {
        setAside(copy.asides.copied);
        react("yes");
      },
      { signal },
    );

    // Le clavier mobile s'ouvre après le focus : on recadre quand la zone visible rétrécit.
    let reframe = 0;
    window.visualViewport?.addEventListener(
      "resize",
      () => {
        if (performance.now() > revealUntil) return;
        window.cancelAnimationFrame(reframe);
        reframe = window.requestAnimationFrame(() => reveal());
      },
      { signal },
    );
    input.addEventListener("focus", () => (revealUntil = performance.now() + 2500), { signal });

    freeInput.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Enter" || event.isComposing || event.shiftKey) return;
        event.preventDefault();
        if (isTextStep(state.step)) {
          // En pleine saisie d'une étape : la note est gardée, on revient au champ de l'étape.
          if (freeInput.value.trim()) {
            freeAside.dataset.tone = "info";
            freeAside.textContent = copy.asides.extraKept;
            react("yes");
          }
          input.focus({ preventScroll: true });
          return;
        }
        submit();
      },
      { signal },
    );

    freeInput.addEventListener(
      "input",
      () => {
        resizeField(freeInput);
        state.extra = freeInput.value;
        if (freeAside.dataset.tone === "error") freeAside.textContent = "";
        const charWidth = parseFloat(getComputedStyle(freeInput).fontSize) * 0.62;
        const lastLine = freeInput.value.split("\n").pop() ?? "";
        const progress = Math.min((lastLine.length * charWidth) / (freeInput.clientWidth || 1), 1);
        arthur?.lookAtElement(freeInput, 0.05 + progress * 0.9);
      },
      { signal },
    );

    freeInput.addEventListener(
      "focus",
      () => {
        arthur?.lookAtElement(freeInput, 0.1);
        react("focus");
      },
      { signal },
    );

    freeInput.addEventListener(
      "blur",
      () => {
        arthur?.releaseLook();
        if (state.status !== "sending") react("calm");
      },
      { signal },
    );

    wide.addEventListener(
      "change",
      () => {
        placePrompt();
        renderPrompt(false);
      },
      { signal },
    );

    render({ focus: false, delay: FIRST_DELAY_MS });

    void whenArthurReady(document.getElementById("contact-arthur"))
      .then((instance) => {
        if (signal.aborted) return;
        arthur = instance;
        arthur.react("hello");
      })
      .catch(() => {
        // Sans Arthur, le formulaire fonctionne quand même.
      });
  }

  document.addEventListener("astro:page-load", initContactConsole);
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = null;
  });
</script>
