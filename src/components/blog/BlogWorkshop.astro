---
import type { Locale } from '../../i18n';

interface Props { kind?: 'direction' | 'component' | 'references' | 'brief' | 'review'; lang: Locale }
const { kind, lang } = Astro.props;
const fr = lang === 'fr';
const fields = fr ? [
  ['Personne et situation', 'Une personne découvre un atelier culturel sur son téléphone, dans les transports.'],
  ['Tâche prioritaire', 'Vérifier la date, le prix et les conditions avant de demander une place.'],
  ['Impression à construire', 'Un lieu ouvert et curieux, avec des informations précises plutôt qu’une pression à réserver.'],
  ['Contraintes et responsabilité', 'FR/EN, connexion variable, modification par l’équipe, domaine et contenus sous son contrôle.'],
  ['Critères de réussite', 'Date et prix lisibles avant l’action ; parcours au clavier ; erreur expliquée sans perdre la saisie.'],
  ['Inconnues et prochaine vérification', 'Le vocabulaire de réservation est-il compris ? Observer le parcours avec des participants représentatifs.'],
] : [
  ['Person and situation', 'Someone discovers a cultural workshop on their phone while travelling.'],
  ['Priority task', 'Check the date, price and conditions before requesting a place.'],
  ['Intended impression', 'An open, curious place with clear information and no pressure to book.'],
  ['Constraints and responsibility', 'FR/EN, variable connectivity, team-managed content, team ownership of domain and content.'],
  ['Success criteria', 'Date and price visible before the action; keyboard access; errors explained without losing input.'],
  ['Unknowns and next check', 'Is the booking language understood? Observe the journey with representative participants.'],
];
const references = fr ? [
  ['Une démarche en plusieurs temps', 'Dossier', 'Coordonnées : renseignées · Pièces : à fournir · Envoi : disponible ensuite', 'Rendre visible ce qui reste à faire. À écarter si la tâche est simple ou strictement linéaire.', 'https://design-system.service.gov.uk/components/task-list/'],
  ['Une erreur à réparer', 'À corriger avant de continuer', 'Date : indiquez le jour souhaité.', 'Nommer le problème et relier le résumé au champ concerné. Le rouge seul ne suffit pas.', 'https://design-system.service.gov.uk/components/error-summary/'],
  ['Un premier usage sans contenu', 'Votre espace est prêt', 'Aucun atelier enregistré. Vous pouvez créer le premier.', 'Expliquer cette absence et proposer la prochaine action. Une panne demanderait un autre message.', 'https://primer.style/product/components/blankslate/'],
] : [
  ['A task across several visits', 'Application', 'Contact details: added · Documents: needed · Submission: available later', 'Make remaining work visible. Avoid this pattern for a simple task or a strictly linear journey.', 'https://design-system.service.gov.uk/components/task-list/'],
  ['An error to repair', 'Check before continuing', 'Date: enter your preferred day.', 'Name the problem and link the summary to its field. Red alone is not enough.', 'https://design-system.service.gov.uk/components/error-summary/'],
  ['A first visit without content', 'Your workspace is ready', 'No workshops saved. You can create the first one.', 'Explain the absence and offer a next step. A service failure would need a different message.', 'https://primer.style/product/components/blankslate/'],
];
---

{kind && (
  <section id={fr ? 'atelier' : 'workshop'} class="blog-workshop" data-blog-workshop={kind} data-lang={lang} aria-labelledby="workshop-heading">
    <header>
      <p class="workshop-label">{fr ? 'Observer · essayer · décider' : 'Observe · try · decide'}</p>
      <h2 id="workshop-heading">{fr ? 'Un exemple à manipuler' : 'An example to explore'}</h2>
      <p>{fr ? 'Exemple pédagogique créé pour cet article, pas un projet client ni un test utilisateur. Aucune réservation réelle.' : 'A teaching example made for this article, not a client project or a user study. No real bookings.'}</p>
    </header>

    {(kind === 'direction' || kind === 'review') && (
      <>
        <div class="workshop-controls" role="group" aria-label={fr ? 'Comparer les variantes' : 'Compare variants'}>
          <button type="button" data-variant="calm" aria-pressed="true">{kind === 'review' ? (fr ? 'Hiérarchie claire' : 'Clear hierarchy') : (fr ? 'Direction calme' : 'Calm direction')}</button>
          <button type="button" data-variant="expressive" aria-pressed="false">{kind === 'review' ? (fr ? 'Actions concurrentes' : 'Competing actions') : (fr ? 'Direction expressive' : 'Expressive direction')}</button>
        </div>
        <div class="workshop-example" data-variant-panel="calm" data-review={kind === 'review' ? 'true' : undefined}>
          <span class="example-eyebrow">{fr ? 'Atelier fictif · Bruxelles' : 'Fictional workshop · Brussels'}</span>
          <h3>{fr ? 'Faire place à la couleur.' : 'Make room for colour.'}</h3>
          <p>{fr ? 'Une matinée pour explorer les formes et composer votre affiche.' : 'A morning to explore shapes and compose your own poster.'}</p>
          <p class="example-facts">{fr ? 'Samedi · 10 h–12 h · 25 € · Matériel compris' : 'Saturday · 10 am–12 pm · €25 · Materials included'}</p>
          {kind === 'review' && <div class="example-distractions" hidden><span>{fr ? 'Newsletter' : 'Newsletter'}</span><span>{fr ? 'Tous les événements' : 'All events'}</span><span>{fr ? 'Devenir membre' : 'Become a member'}</span></div>}
          <button type="button" data-example-action>{fr ? 'Voir les modalités' : 'View booking details'}</button>
          <p class="example-feedback" aria-live="polite" data-example-feedback></p>
        </div>
        <ol class="workshop-notes">
          <li>{fr ? 'La tâche reste identique : comprendre l’offre avant de s’engager.' : 'The task stays the same: understand the offer before committing.'}</li>
          <li>{kind === 'review' ? (fr ? 'Les trois invitations supplémentaires concurrencent le prochain pas sans aider à choisir cet atelier.' : 'The three extra invitations compete with the next step without helping someone choose this workshop.') : (fr ? 'La typographie, l’accent et la forme changent ; la date, le prix et l’action restent lisibles.' : 'Type, accent and shape change; the date, price and action remain readable.')}</li>
          <li>{fr ? 'Une préférence visuelle ne démontre pas un effet sur les inscriptions. Il faudrait observer de vrais usages.' : 'A visual preference does not prove an effect on bookings. That would require observing real use.'}</li>
        </ol>
      </>
    )}

    {kind === 'component' && (
      <>
        <div class="workshop-controls">
          <label><input type="checkbox" data-compact />{fr ? 'Conteneur étroit' : 'Narrow container'}</label>
          <label><input type="checkbox" data-long-label />{fr ? 'Libellé long' : 'Long label'}</label>
        </div>
        <form class="workshop-example booking-example" data-booking-form novalidate>
          <h3>{fr ? 'Demander une place' : 'Request a place'}</h3>
          <p>{fr ? 'Simulation locale : aucune donnée envoyée ni conservée après votre départ.' : 'Local simulation: nothing is sent or retained after you leave.'}</p>
          <label for="workshop-name">{fr ? 'Prénom (obligatoire)' : 'First name (required)'}</label>
          <input id="workshop-name" name="name" type="text" required autocomplete="off" aria-describedby="workshop-name-message" />
          <p id="workshop-name-message" class="field-message" aria-live="polite"></p>
          <button type="submit" data-booking-submit data-short={fr ? 'Vérifier ma demande' : 'Check my request'} data-long={fr ? 'Vérifier ma demande de participation à cet atelier' : 'Check my request to take part in this workshop'}>{fr ? 'Vérifier ma demande' : 'Check my request'}</button>
          <p class="example-feedback" data-booking-result aria-live="polite"></p>
        </form>
        <p class="workshop-footnote">{fr ? 'Essayez le bouton à vide, puis avec un prénom. Répétez au clavier, en largeur réduite et avec le libellé long. La validation serveur et les états réseau ne sont pas simulés.' : 'Try submitting an empty field, then a name. Repeat with the keyboard, narrow width and long label. Server validation and network states are not simulated.'}</p>
      </>
    )}

    {kind === 'references' && (
      <div class="reference-examples">
        <p>{fr ? 'Schémas originaux, simplifiés à partir des principes documentés. Ce ne sont pas des captures des services cités.' : 'Original simplified sketches of documented principles, not screenshots of the referenced services.'}</p>
        {references.map(([title, heading, example, lesson, href]) => (
          <details>
            <summary>{title}</summary>
            <div class="reference-sketch"><strong>{heading}</strong><p>{example}</p></div>
            <p>{lesson}</p>
            <a href={href}>{fr ? 'Consulter la référence originale' : 'Open the original reference'}</a>
          </details>
        ))}
      </div>
    )}

    {kind === 'brief' && (
      <form data-brief-form>
        <p>{fr ? 'Remplissez les six décisions, puis emportez un fichier Markdown modifiable. Ces champs restent dans votre navigateur : pas de compte, de stockage ou d’envoi au serveur.' : 'Fill in six decisions, then download an editable Markdown file. Fields stay in your browser: no account, storage or server submission.'}</p>
        <button type="button" data-brief-example>{fr ? 'Insérer l’exemple fictif' : 'Insert the fictional example'}</button>
        <div class="brief-fields">
          {fields.map(([label, example], index) => <div><label for={`brief-${index}`}>{index + 1}. {label}</label><textarea id={`brief-${index}`} name={`brief-${index}`} rows="3" data-label={label} data-example={example}></textarea></div>)}
        </div>
        <button type="submit">{fr ? 'Télécharger mon brief (.md)' : 'Download my brief (.md)'}</button>
        <p class="example-feedback" data-brief-result aria-live="polite"></p>
      </form>
    )}
    <noscript><p>{fr ? 'JavaScript est désactivé. Les explications restent disponibles ; les variantes et le téléchargement nécessitent JavaScript.' : 'JavaScript is disabled. Explanations remain available; variants and downloading require JavaScript.'}</p></noscript>
  </section>
)}

<script>
  function initializeWorkshops() {
    document.querySelectorAll<HTMLElement>('[data-blog-workshop]').forEach((root) => {
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';
      const fr = root.dataset.lang === 'fr';
      root.querySelectorAll<HTMLButtonElement>('[data-variant]').forEach((button) => {
        button.addEventListener('click', () => {
          root.querySelectorAll('[data-variant]').forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
          const panel = root.querySelector<HTMLElement>('[data-variant-panel]');
          if (panel) panel.dataset.variantPanel = button.dataset.variant;
          const distractions = root.querySelector<HTMLElement>('.example-distractions');
          if (distractions) distractions.hidden = button.dataset.variant !== 'expressive';
        });
      });
      root.querySelector('[data-example-action]')?.addEventListener('click', () => {
        root.querySelector('[data-example-feedback]')!.textContent = fr ? 'Dans un vrai service : les conditions et les places disponibles. Ici, aucune réservation n’est effectuée.' : 'In a real service: conditions and available places. No booking is made here.';
      });
      const booking = root.querySelector<HTMLFormElement>('[data-booking-form]');
      root.querySelector<HTMLInputElement>('[data-compact]')?.addEventListener('change', (event) => {
        if (booking) booking.dataset.compact = String((event.target as HTMLInputElement).checked);
      });
      root.querySelector<HTMLInputElement>('[data-long-label]')?.addEventListener('change', (event) => {
        const button = root.querySelector<HTMLButtonElement>('[data-booking-submit]');
        if (button) button.textContent = ((event.target as HTMLInputElement).checked ? button.dataset.long : button.dataset.short) || '';
      });
      booking?.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = booking.querySelector<HTMLInputElement>('input[name="name"]')!;
        const valid = Boolean(input.value.trim());
        input.setAttribute('aria-invalid', String(!valid));
        booking.querySelector('#workshop-name-message')!.textContent = valid ? '' : (fr ? 'Indiquez un prénom pour essayer la confirmation.' : 'Enter a first name to try the confirmation.');
        booking.querySelector('[data-booking-result]')!.textContent = valid ? (fr ? 'Demande vérifiée dans cette démonstration. Rien n’a été envoyé.' : 'Request checked in this demo. Nothing has been sent.') : '';
        if (!valid) input.focus();
      });
      const brief = root.querySelector<HTMLFormElement>('[data-brief-form]');
      root.querySelector('[data-brief-example]')?.addEventListener('click', () => {
        const inputs = Array.from(root.querySelectorAll<HTMLTextAreaElement>('textarea'));
        if (inputs.some((input) => input.value.trim()) && !window.confirm(fr ? 'Remplacer votre texte par l’exemple fictif ?' : 'Replace your text with the fictional example?')) return;
        inputs.forEach((input) => { input.value = input.dataset.example || ''; });
      });
      brief?.addEventListener('submit', (event) => {
        event.preventDefault();
        const inputs = Array.from(brief.querySelectorAll<HTMLTextAreaElement>('textarea'));
        const content = '# ' + (fr ? 'Brief d’expérience web' : 'Web experience brief') + '\n\n' + inputs.map((input) => `## ${input.dataset.label}\n\n${input.value.trim() || (fr ? 'À préciser.' : 'To be defined.')}\n`).join('\n');
        const url = URL.createObjectURL(new Blob([content], { type: 'text/markdown;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = `horde-brief-${fr ? 'fr' : 'en'}.md`;
        document.body.append(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        brief.querySelector('[data-brief-result]')!.textContent = fr ? 'Fichier préparé. Conservez-le avant de fermer cette page.' : 'File prepared. Save it before closing this page.';
      });
    });
  }
  initializeWorkshops();
  document.addEventListener('astro:page-load', initializeWorkshops);
</script>

<style>
  .blog-workshop { margin: 2.5rem 0; padding: clamp(1rem, 4vw, 2rem); border: 1px solid #48484f; border-radius: 1.25rem; background: #17171c; color: #faf9f6; overflow-wrap: anywhere; }
  .blog-workshop header { margin-bottom: 1.5rem; }
  .blog-workshop h2 { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.2; margin: .6rem 0 1rem; }
  .blog-workshop p, .blog-workshop li { font-size: 1rem; line-height: 1.65; }
  .workshop-label { color: #d2c2ff; font-size: .75rem !important; letter-spacing: .08em; text-transform: uppercase; }
  .workshop-controls { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .blog-workshop button, .blog-workshop summary { cursor: pointer; min-height: 48px; }
  .blog-workshop button { border: 1px solid #a99bd1; border-radius: .6rem; padding: .75rem 1rem; font: inherit; font-size: .95rem; line-height: 1.45; white-space: normal; max-width: 100%; }
  .workshop-controls button[aria-pressed="true"], [data-brief-form] button { background: #d2c2ff; color: #191523; }
  .workshop-controls button[aria-pressed="false"] { background: transparent; color: #faf9f6; }
  .blog-workshop :is(button, input, textarea, summary, a):focus-visible { outline: 3px solid #cce843; outline-offset: 4px; }
  .workshop-controls label { display: flex; align-items: center; gap: .6rem; min-height: 48px; cursor: pointer; }
  .workshop-controls input { accent-color: #d2c2ff; width: 1.2rem; height: 1.2rem; }
  .workshop-example { background: #f8f5ec; color: #17203a; padding: clamp(1rem, 4vw, 2rem); border-radius: .75rem; }
  .workshop-example h3 { font-family: Georgia, serif; font-size: clamp(1.75rem, 5vw, 2.5rem); line-height: 1.1; margin: 1.25rem 0; }
  .example-eyebrow { font-size: .8rem; letter-spacing: .07em; text-transform: uppercase; }
  .example-facts { border-block: 1px solid currentColor; padding: .8rem 0; margin: 1.5rem 0; font-weight: 600; }
  .workshop-example button { background: #17203a; color: #fff; border-color: #17203a; }
  .workshop-example :is(button, input):focus-visible { outline-color: #244ce3; }
  [data-variant-panel="expressive"]:not([data-review]) { background: #d2c2ff; border-radius: 2rem .3rem 2rem .3rem; box-shadow: inset 8px 0 #244ce3; }
  [data-variant-panel="expressive"]:not([data-review]) h3 { font-family: inherit; font-weight: 850; letter-spacing: -.035em; }
  [data-variant-panel="expressive"]:not([data-review]) button { background: #244ce3; color: white; }
  .example-distractions:not([hidden]) { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .example-distractions span { border: 1px solid #17203a; border-radius: .6rem; padding: .6rem; font-weight: 600; }
  .example-feedback:empty, .field-message:empty { display: none; }
  .example-feedback { margin-top: 1rem; }
  .workshop-notes { padding-left: 1.4rem; list-style: decimal; margin-top: 1.5rem; }
  .workshop-notes li + li { margin-top: .7rem; }
  .booking-example { max-width: 100%; }
  .booking-example[data-compact="true"] { max-width: 320px; }
  .booking-example label, .brief-fields label { display: block; font-weight: 650; margin: 1rem 0 .5rem; }
  .booking-example input, .brief-fields textarea { width: 100%; min-width: 0; min-height: 48px; border: 1px solid #555560; border-radius: .4rem; padding: .75rem; background: #fff; color: #17203a; font: inherit; }
  .booking-example input[aria-invalid="true"] { border: 2px solid #9b2130; }
  .booking-example button { margin-top: 1rem; }
  .field-message { color: #8b1c2a; margin-top: .5rem; }
  .workshop-footnote { margin-top: 1rem; }
  .reference-examples details { border-top: 1px solid #555560; padding: .75rem 0; }
  .reference-examples summary { display: list-item; padding: .7rem 0; font-weight: 650; }
  .reference-sketch { border-left: 4px solid #cce843; padding: 1rem; margin: .75rem 0; background: #24242c; }
  .reference-sketch strong { display: block; margin-bottom: .5rem; }
  .reference-examples a { display: inline-block; margin-top: .6rem; color: #d2c2ff; text-decoration: underline; text-underline-offset: .2em; }
  .brief-fields { display: grid; gap: .5rem; margin-bottom: 1.5rem; }
  .brief-fields textarea { resize: vertical; background: #24242c; color: #faf9f6; }
  [data-brief-example] { margin-top: 1rem; }
  @media (min-width: 700px) { .brief-fields { grid-template-columns: 1fr 1fr; gap: 1rem; } }
</style>
