---
/**
 * Gabarit commun des deux URL de la page prix (FR /fr/prix-site-web/, EN /en/website-prices/) :
 * mise en page, données structurées (catalogue d'offres HTVA) et pause du bandeau hors écran.
 */
import Layout from "../../layouts/Layout.astro";
import Footer from "../Footer.astro";
import PricingPage from "./PricingPage.astro";
import "../home/home.css";
import type { Locale } from "../../i18n";
import { getPricingCopy, getPricingHref } from "./copy";
import { getPricingRows } from "./rows";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getPricingCopy(lang);
const otherLang: Locale = lang === "fr" ? "en" : "fr";
const site = Astro.site ?? new URL("https://hordeagence.com");
const pageUrl = new URL(getPricingHref(lang), site).href;
const alternateUrl = new URL(getPricingHref(otherLang), site).href;
const rows = await getPricingRows(lang);

// La FAQ (ServiceFaqSection) publie elle-même son FAQPage.
const catalog = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: copy.seoTitle,
  url: pageUrl,
  itemListElement: rows.map((row) => {
    const serviceUrl = new URL(row.url, site).href;
    const { from, to, unit } = row.pricing;
    return {
      "@type": "Offer",
      url: serviceUrl,
      priceCurrency: "EUR",
      price: from,
      itemOffered: { "@type": "Service", name: row.name, url: serviceUrl },
      priceSpecification: {
        "@type": unit ? "UnitPriceSpecification" : "PriceSpecification",
        priceCurrency: "EUR",
        ...(unit
          ? { price: from, unitCode: "DAY", unitText: lang === "fr" ? "jour" : "day" }
          : { minPrice: from }),
        ...(to ? { maxPrice: to } : {}),
        valueAddedTaxIncluded: false,
      },
    };
  }),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(catalog)} />

<Layout lang={lang} title={copy.seoTitle} description={copy.seoDescription} alternateUrl={alternateUrl} headerVariant="light" bare>
  <article class="home-page pricing-page relative">
    <PricingPage lang={lang} />
  </article>
  <div slot="footer" class="pricing-page__footer">
    <Footer lang={lang} variant="dark" />
  </div>
</Layout>

<style>
  .pricing-page__footer {
    padding-inline: 1rem;
    background: var(--color-black);
    overflow-x: clip;
  }

  @media (min-width: 640px) {
    .pricing-page__footer {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .pricing-page__footer {
      padding-inline: 3.6rem;
    }
  }
</style>

<script>
  // Bandeau défilant mis en pause hors de l'écran.
  import { pauseOffscreen } from "../../lib/pause-offscreen";

  pauseOffscreen();
  document.addEventListener("astro:page-load", () => pauseOffscreen());
</script>
