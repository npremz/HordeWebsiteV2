---
/**
 * Gabarit commun des deux URL de la page prix (FR /fr/prix-site-web/, EN /en/website-prices/) :
 * mise en page, données structurées (catalogue d'offres HTVA + FAQ) et apparition au scroll.
 */
import Layout from "../../layouts/Layout.astro";
import Footer from "../Footer.astro";
import PricingPage from "./PricingPage.astro";
import "../home/home.css";
import type { Locale } from "../../i18n";
import { getServiceSummaries } from "../../lib/content/services";
import { getPricingCopy, getPricingHref } from "./copy";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getPricingCopy(lang);
const otherLang: Locale = lang === "fr" ? "en" : "fr";
const site = Astro.site ?? new URL("https://hordeagence.com");
const pageUrl = new URL(getPricingHref(lang), site).href;
const alternateUrl = new URL(getPricingHref(otherLang), site).href;
const services = await getServiceSummaries(lang);
const bySlug = new Map(services.map((service) => [service.slug, service]));

const catalog = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: copy.seoTitle,
  url: pageUrl,
  itemListElement: copy.offers.flatMap((offer) => {
    const service = bySlug.get(offer.slug);
    const pricing = service?.entry.data.pricing;
    if (!service || !pricing) return [];
    const serviceUrl = new URL(service.url, site).href;
    return [{
      "@type": "Offer",
      url: serviceUrl,
      priceCurrency: "EUR",
      price: pricing.from,
      itemOffered: { "@type": "Service", name: offer.name, url: serviceUrl },
      priceSpecification: {
        "@type": pricing.unit ? "UnitPriceSpecification" : "PriceSpecification",
        priceCurrency: "EUR",
        ...(pricing.unit
          ? { price: pricing.from, unitCode: "DAY", unitText: lang === "fr" ? "jour" : "day" }
          : { minPrice: pricing.from }),
        ...(pricing.to ? { maxPrice: pricing.to } : {}),
        valueAddedTaxIncluded: false,
      },
    }];
  }),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: copy.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(catalog)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<Layout lang={lang} title={copy.seoTitle} description={copy.seoDescription} alternateUrl={alternateUrl} headerVariant="dark" bare>
  <script is:inline>document.documentElement.classList.add("home-js");</script>
  <article class="home-page pricing-page relative">
    <PricingPage lang={lang} />
  </article>
  <div slot="footer" class="pricing-page__footer">
    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .pricing-page__footer {
    padding-inline: 1rem;
    background: var(--color-bg);
    overflow-x: clip;
  }

  @media (min-width: 640px) {
    .pricing-page__footer {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .pricing-page__footer {
      padding-inline: 3.6rem;
    }
  }
</style>

<script>
  import { initHomeReveal } from "../../lib/home-reveal";
  import { pauseOffscreen } from "../../lib/pause-offscreen";

  initHomeReveal();
  pauseOffscreen();
  document.addEventListener("astro:page-load", () => {
    initHomeReveal();
    pauseOffscreen();
  });
</script>
