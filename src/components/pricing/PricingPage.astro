---
/**
 * Page « Prix d'un site web » : même langage visuel que la home et la page « Notre culture »
 * (hero noir à lignes de construction, labels mono, rails, cartes de la section méthode,
 * bloc final sombre). Surface « Compare » : une liste alignée, un prix par ligne.
 */
import type { Locale } from "../../i18n";
import { BUSINESS } from "../../lib/business-info";
import { getServiceSummaries } from "../../lib/content/services";
import HeroLines from "../home/svg/HeroLines.astro";
import { HOME_ICONS } from "../home/svg/icons";
import HomeLink from "../home/ui/HomeLink.astro";
import SlashMark from "../home/ui/SlashMark.astro";
import { formatEuro, getPricingCopy } from "./copy";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = getPricingCopy(lang);
const services = await getServiceSummaries(lang);
const bySlug = new Map(services.map((service) => [service.slug, service]));
const contactHref = `/${lang}/contact/`;
const bookingHref = BUSINESS.bookingUrl;

const offers = copy.offers.map((offer, index) => {
  const service = bySlug.get(offer.slug);
  const pricing = service?.entry.data.pricing;
  if (!service || !pricing) throw new Error(`[pricing] prix manquant pour ${offer.slug}`);
  return { ...offer, index: String(index + 1).padStart(2, "0"), url: service.url, pricing };
});
const auditHref = offers.find((offer) => offer.slug === "audit-offert")!.url;
---

<!-- 1. Hero -->
<section class="pr-hero relative overflow-clip bg-black text-white" data-header-theme="dark">
  <HeroLines class="pointer-events-none absolute inset-0 h-full w-full" />
  <div class="pr-hero__inner home-column relative">
    <p class="pr-eyebrow">{copy.hero.eyebrow}</p>
    <h1 class="pr-hero__title">
      {copy.hero.titleLines.map((line, index) => (
        <><span class="pr-hero__line"><span style={`--line: ${index}`}>{line}</span></span>{index < copy.hero.titleLines.length - 1 && " "}</>
      ))}
    </h1>
    <p class="pr-hero__lead">{copy.hero.lead}</p>
    <div class="pr-hero__meta">
      <a href={auditHref} class="pr-button pr-button--light group">
        {copy.hero.audit}
        <svg viewBox="0 0 22 22" fill="currentColor" aria-hidden="true"><path d={HOME_ICONS.spark.paths[0].d} /></svg>
      </a>
      <HomeLink href={bookingHref} label={copy.hero.bookCall} tone="light" icon="arrow" external newTabLabel={copy.cta.newTab} />
    </div>
    <p class="pr-hero__updated">{copy.hero.updated}</p>
  </div>
</section>

<!-- 2. Mode d'emploi des fourchettes -->
<section class="pr-reading relative bg-bg" data-header-theme="light">
  <div class="home-column relative">
    <p class="home-lead pr-lead" data-home-reveal>
      <span class="home-lead__label">{copy.reading.label}</span>
      {copy.reading.text}
    </p>
  </div>
</section>

<!-- 3. Liste des prix -->
<section class="pr-list relative bg-bg" data-header-theme="light" aria-labelledby="pr-list-title">
  <div class="home-column home-column--wide">
    <div class="pr-list__head">
      <h2 id="pr-list-title" class="pr-list__title">{copy.list.title}</h2>
      <SlashMark spin />
    </div>

    <div class="pr-table" role="list">
      <div class="pr-table__cols" aria-hidden="true">
        <span>{copy.list.colProject}</span>
        <span>{copy.list.colPrice}</span>
      </div>

      {offers.map((offer) => (
        <article class:list={["pr-row", offer.slug === "audit-offert" && "pr-row--free"]} role="listitem" data-home-reveal>
          <span class="pr-row__index">{offer.index}</span>

          <div class="pr-row__body">
            <h3 class="pr-row__name">{offer.name}</h3>
            <p class="pr-row__pitch">{offer.pitch}</p>
          </div>

          <div class="pr-row__price">
            {offer.pricing.from === 0 ? (
              <p class="pr-price__value">{copy.list.free}</p>
            ) : offer.pricing.unit === "day" ? (
              <>
                <p class="pr-price__value">
                  {formatEuro(offer.pricing.from, lang)}
                  <span class="pr-price__unit"> / {copy.list.perDay}</span>
                </p>
                <p class="pr-price__note">{copy.list.vat}</p>
              </>
            ) : (
              <>
                <p class="pr-price__from">{copy.list.from}</p>
                <p class="pr-price__value">{formatEuro(offer.pricing.from, lang)}</p>
                <p class="pr-price__note">
                  {offer.pricing.to
                    ? `${copy.list.vat}. ${copy.list.upTo} ${formatEuro(offer.pricing.to, lang)} ${copy.list.vat}.`
                    : offer.slug === "applications-evenementielles"
                      ? `${copy.list.vat}. ${copy.list.onQuote}.`
                      : `${copy.list.vat}.`}
                </p>
              </>
            )}
            {offer.details && (
              <ul class="pr-price__details">
                {offer.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}
          </div>

          <div class="pr-row__link">
            <HomeLink href={offer.url} label={copy.list.see} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 4. FAQ -->
<section class="pr-faq relative bg-white" data-header-theme="light">
  <div class="home-column home-column--wide pr-faq__grid">
    <h2 class="pr-faq__title">{copy.faqTitle}</h2>
    <div>
      {copy.faq.map((item, index) => (
        <details class="pr-faq__item" open={index === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="pr-faq__icon" aria-hidden="true"><svg viewBox="0 0 8.86 9.1" fill="currentColor"><path d={HOME_ICONS.plus.paths[0].d} /></svg></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
      <p class="pr-faq__guide">
        {copy.guide.text} <a href={copy.guide.href}>{copy.guide.link}</a>
      </p>
    </div>
  </div>
</section>

<!-- 5. Appel final -->
<section class="pr-cta relative bg-black text-white" data-header-theme="dark">
  <div class="home-column home-column--wide relative">
    <p class="pr-eyebrow">{copy.cta.label}</p>
    <h2 class="pr-cta__title">{copy.cta.title}</h2>
    <p class="pr-cta__text">{copy.cta.text}</p>
    <div class="pr-cta__actions">
      <a href={bookingHref} class="pr-button pr-button--light pr-button--wide group" target="_blank" rel="noopener">
        <span>
          {copy.cta.bookCall}
          <span class="pr-button__meta">({copy.cta.bookCallMeta})</span>
        </span>
        <span class="sr-only"> {copy.cta.newTab}</span>
        <svg viewBox="0 0 22 22" fill="currentColor" aria-hidden="true"><path d={HOME_ICONS.spark.paths[0].d} /></svg>
      </a>
      <HomeLink href={contactHref} label={copy.cta.contact} tone="light" />
    </div>
  </div>
</section>

<style>
  .pr-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(244 241 248 / 0.65);
  }

  /* Bouton plein (barre du CTA de la home), clair sur fond sombre. */
  .pr-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 3.25rem;
    padding-inline: 1.25rem;
    border-radius: 6px;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    transition: padding 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pr-button--light {
    background: var(--color-white);
    color: var(--color-black);
  }

  .pr-button--wide {
    width: 100%;
    max-width: 22rem;
  }

  .pr-button svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pr-button__meta {
    margin-left: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #4d4b51;
  }

  .pr-button:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .pr-button:hover {
      padding-inline: 1.6rem 1rem;
    }

    .pr-button:hover svg {
      transform: rotate(90deg);
    }
  }

  /* ---------- Hero ---------- */

  .pr-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 32rem;
    padding-block: 7rem 3rem;
  }

  .pr-hero__title {
    margin-top: 1.5rem;
    font-size: clamp(2.2rem, 11vw, 3.6rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .pr-hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.2em;
    margin-bottom: -0.2em;
  }

  .pr-hero__line > span {
    display: block;
    animation: pr-hero-line 0.9s cubic-bezier(0.77, 0, 0.18, 1) both;
    animation-delay: calc(0.15s + var(--line) * 0.1s);
  }

  @keyframes pr-hero-line {
    from {
      transform: translateY(calc(100% + 0.25em));
    }
  }

  .pr-hero__lead {
    max-width: 30rem;
    margin-top: 1.75rem;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: rgb(244 241 248 / 0.85);
  }

  .pr-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
    margin-top: 2.5rem;
  }

  .pr-hero__updated {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(244 241 248 / 0.55);
  }

  /* ---------- Mode d'emploi ---------- */

  .pr-reading {
    padding-block: 5rem 1rem;
  }

  @media (max-width: 639px) {
    .pr-lead {
      text-indent: 0;
    }

    .pr-lead .home-lead__label {
      position: static;
      display: block;
      width: auto;
      margin-bottom: 0.9rem;
    }
  }

  /* ---------- Liste ---------- */

  .pr-list {
    padding-block: 4rem 6rem;
  }

  .pr-list__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pr-list__title {
    font-size: clamp(1.75rem, 7vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .pr-table {
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--color-black);
  }

  .pr-table__cols {
    display: none;
  }

  .pr-row {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.75rem 0.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-black);
  }

  .pr-row__index {
    padding-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .pr-row__name {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .pr-row__pitch {
    margin-top: 0.75rem;
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: #3b3a3e;
  }

  .pr-row__price,
  .pr-row__link {
    grid-column: 2;
  }

  .pr-row__link {
    display: flex;
    justify-content: flex-end;
  }

  .pr-price__from,
  .pr-price__note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pr-price__note {
    max-width: 17rem;
    margin-top: 0.4rem;
    color: #4d4b51;
  }

  .pr-price__value {
    margin-top: 0.15rem;
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .pr-price__unit {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .pr-price__details {
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px dashed #9e9aa4;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .pr-price__details li::before {
    content: "— ";
  }

  /* Audit offert : carte claire, comme les étapes de la section méthode. */
  .pr-row--free {
    position: relative;
  }

  .pr-row--free .pr-price__value {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 1rem;
    border: 2px solid #d6d2da;
    border-radius: 6px;
    background: var(--color-bg-light);
    font-size: 1.75rem;
  }

  /* ---------- FAQ ---------- */

  .pr-faq {
    padding-block: 5rem;
  }

  .pr-faq__grid {
    display: grid;
    gap: 2rem;
  }

  .pr-faq__title {
    font-size: clamp(1.75rem, 7vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .pr-faq__item {
    border-top: 1px solid var(--color-black);
  }

  .pr-faq__item:last-of-type {
    border-bottom: 1px solid var(--color-black);
  }

  .pr-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 1rem;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    cursor: pointer;
    list-style: none;
  }

  .pr-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .pr-faq__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 6px;
    background: var(--color-black);
    color: var(--color-white);
  }

  .pr-faq__icon svg {
    width: 0.625rem;
    height: 0.625rem;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pr-faq__item[open] .pr-faq__icon svg {
    transform: rotate(45deg);
  }

  .pr-faq__item summary:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  .pr-faq__item p {
    max-width: 38rem;
    padding-bottom: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .pr-faq__guide {
    margin-top: 2rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .pr-faq__guide a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* ---------- Appel final ---------- */

  .pr-cta {
    padding-block: 5rem 5.5rem;
  }

  .pr-cta__title {
    margin-top: 1.25rem;
    font-size: clamp(2.1rem, 9vw, 4.25rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .pr-cta__text {
    max-width: 32rem;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: rgb(244 241 248 / 0.75);
  }

  .pr-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    margin-top: 2.75rem;
  }

  /* ---------- Breakpoints (alignés sur la home) ---------- */

  @media (min-width: 768px) {
    .pr-row {
      grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 15rem);
      gap: 0 2rem;
      align-items: start;
    }

    .pr-row__price {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .pr-row__link {
      grid-column: 2;
      justify-content: flex-start;
      margin-top: 1.5rem;
    }

    .pr-cta__actions {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .pr-hero__inner {
      min-height: 40rem;
    }

    .pr-hero__title {
      font-size: 5rem;
    }

    .pr-reading {
      padding-block: 7rem 2rem;
    }

    .pr-list {
      padding-block: 5rem 8rem;
    }

    .pr-table {
      margin-top: 3.5rem;
    }

    .pr-table__cols {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 17rem);
      gap: 0 2.5rem;
      padding-bottom: 0.9rem;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .pr-table__cols span:first-child {
      grid-column: 2;
    }

    .pr-row {
      grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 17rem);
      gap: 0 2.5rem;
      padding-block: 2.25rem;
    }

    .pr-row__name {
      font-size: 2rem;
    }

    .pr-row__pitch {
      font-size: 1.0625rem;
    }

    .pr-price__value {
      font-size: 3.25rem;
    }

    .pr-faq {
      padding-block: 7.5rem;
    }

    .pr-faq__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }

    .pr-cta {
      padding-block: 7.5rem 8rem;
    }

    .pr-cta__title {
      font-size: 5.5rem;
    }
  }

  @media (min-width: 1512px) {
    .pr-hero__title {
      font-size: 5.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-hero__line > span {
      animation: none;
    }
  }
</style>
