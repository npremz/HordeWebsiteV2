---
import Layout from "../../layouts/Layout.astro";
import HomeHero from "../../components/home/HomeHero.astro";
import HomeIntro from "../../components/home/HomeIntro.astro";
import HomeWorks from "../../components/home/HomeWorks.astro";
import HomeServices from "../../components/home/HomeServices.astro";
import HomeMethod from "../../components/home/HomeMethod.astro";
import HomeTeam from "../../components/home/HomeTeam.astro";
import HomeTalk from "../../components/home/HomeTalk.astro";
import HomeReviews from "../../components/home/HomeReviews.astro";
import Footer from "../../components/Footer.astro";
import PixelTransitionCanvas from "../../components/ui/effects/PixelTransitionCanvas.astro";
import "../../components/home/home.css";
import { SUPPORTED_LOCALES, type Locale, useTranslations } from "../../i18n";
import { getSiteSettings } from "../../lib/site-data";

export const prerender = true;

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const siteSettings = await getSiteSettings(lang);

const title = siteSettings.homepageTitle || "Horde";
const description = siteSettings.defaultDescription || t.homepage.fallbackDescription;
---

<Layout
  lang={lang}
  title={title}
  description={description}
  siteNameAsPrefix={true}
  isHomepage
  headerVariant="dark"
  bare
>
  <script is:inline>document.documentElement.classList.add("home-js");</script>
  <div class="home-page relative">
    <!-- Même transition que l’ancienne home : pixels noirs qui recouvrent l’écran avant les services. -->
    <PixelTransitionCanvas
      color="rgb(15, 16, 17)"
      triggerDistance={500}
      topOffset={600}
      targetId="services"
      stopTargetId="demarche"
      stopWhenTargetCoversViewport
      columns={16}
      class="z-10"
    />
    <HomeHero lang={lang} />
    <HomeIntro lang={lang} />
    <HomeWorks lang={lang} />
    <HomeServices lang={lang} />
    <HomeMethod lang={lang} />
    <HomeTeam lang={lang} />
    <HomeReviews lang={lang} />
    <HomeTalk lang={lang} />
  </div>
  <div slot="footer" class="home-page__footer">
    <Footer lang={lang} />
  </div>
</Layout>

<style>
  /* Mêmes marges que le footer global de la page contact. */
  .home-page__footer {
    padding-inline: 1rem;
    background: var(--color-bg);
    overflow-x: clip;
  }

  @media (min-width: 640px) {
    .home-page__footer {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .home-page__footer {
      padding-inline: 3.6rem;
    }
  }
</style>

<script>
  import { initHomeReveal } from "../../lib/home-reveal";
  import { pauseOffscreen } from "../../lib/pause-offscreen";

  initHomeReveal();
  pauseOffscreen();
  document.addEventListener("astro:page-load", () => {
    initHomeReveal();
    pauseOffscreen();
  });
</script>
