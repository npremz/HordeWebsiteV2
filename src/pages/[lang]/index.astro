---
import Layout from "../../layouts/Layout.astro";
import HomeHeader from "../../components/home/HomeHeader.astro";
import HomeHero from "../../components/home/HomeHero.astro";
import HomeIntro from "../../components/home/HomeIntro.astro";
import HomeWorks from "../../components/home/HomeWorks.astro";
import HomeServices from "../../components/home/HomeServices.astro";
import HomeMethod from "../../components/home/HomeMethod.astro";
import HomeTeam from "../../components/home/HomeTeam.astro";
import HomeTalk from "../../components/home/HomeTalk.astro";
import HomeFooter from "../../components/home/HomeFooter.astro";
import PixelTransitionCanvas from "../../components/ui/effects/PixelTransitionCanvas.astro";
import "../../components/home/home.css";
import { SUPPORTED_LOCALES, type Locale, useTranslations } from "../../i18n";
import { getSiteSettings } from "../../lib/site-data";

export const prerender = true;

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const siteSettings = await getSiteSettings(lang);

const title = siteSettings.homepageTitle || "Horde";
const description = siteSettings.defaultDescription || t.homepage.fallbackDescription;
---

<Layout
  lang={lang}
  title={title}
  description={description}
  siteNameAsPrefix={true}
  isHomepage
  bare
>
  <script is:inline>document.documentElement.classList.add("home-js");</script>
  <div class="home-page relative">
    <!-- Même transition que l’ancienne home : pixels noirs qui recouvrent l’écran avant les services. -->
    <PixelTransitionCanvas
      color="rgb(22, 25, 27)"
      triggerDistance={500}
      topOffset={600}
      targetId="services"
      stopTargetId="demarche"
      stopWhenTargetCoversViewport
      class="z-10"
    />
    <HomeHeader lang={lang} />
    <HomeHero lang={lang} />
    <HomeIntro lang={lang} />
    <HomeWorks lang={lang} />
    <HomeServices lang={lang} />
    <HomeMethod lang={lang} />
    <HomeTeam lang={lang} />
    <HomeTalk lang={lang} />
  </div>
  <HomeFooter slot="footer" lang={lang} />
</Layout>

<script>
  function initHomeReveal() {
    const items = document.querySelectorAll<HTMLElement>("[data-home-reveal]:not(.is-revealed)");
    if (!("IntersectionObserver" in window)) {
      items.forEach((item) => item.classList.add("is-revealed"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px" },
    );

    items.forEach((item) => observer.observe(item));
  }

  initHomeReveal();
  document.addEventListener("astro:page-load", initHomeReveal);
</script>
