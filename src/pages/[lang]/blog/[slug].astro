			margin-bottom: 1.65em;
		}

		.prose :global(h2) {
			margin: 3.25em 0 1.1em;
			scroll-margin-top: 7rem;
			font-size: clamp(1.85rem, 3vw, 2.65rem);
			line-height: 1.08;
			letter-spacing: -0.035em;
			text-wrap: balance;
