---
import BlogCategoryView from '../../../../components/blog/BlogCategoryView.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../../i18n';
import { type CategoryEntry, getCategories, localizeCategory } from '../../../../lib/content/blog';

export const prerender = true;

export async function getStaticPaths() {
  const categories = await getCategories();

  return SUPPORTED_LOCALES.flatMap((lang) =>
    categories.map((category) => {
      const localizedCategory = localizeCategory(category, lang);

      return {
        params: { lang, slug: localizedCategory.slug },
        props: { category, lang },
      };
    }),
  );
}

const { category, lang } = Astro.props as { category: CategoryEntry; lang: Locale };
---

<BlogCategoryView category={category} lang={lang} page={1} />
