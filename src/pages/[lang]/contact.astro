---
import Layout from '../../layouts/Layout.astro';
import HomeHeader from '../../components/home/HomeHeader.astro';
import ContactConsole from '../../components/contact/ContactConsole.astro';
import Footer from '../../components/Footer.astro';
import '../../components/home/home.css';
import { SUPPORTED_LOCALES, type Locale, useTranslations } from '../../i18n';

export const prerender = true;

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout lang={lang} title={t.contact.title} description={t.contact.description} bare>
	<div class="contact-page relative">
		<HomeHeader lang={lang} path="/contact/" />
		<ContactConsole lang={lang} />
	</div>
	<div slot="footer" class="contact-page__footer">
		<Footer lang={lang} />
	</div>
</Layout>

<style>
	.contact-page {
		overflow-x: clip;
	}

	.contact-page__footer {
		padding-inline: 1rem;
		background: var(--color-bg);
		overflow-x: clip;
	}

	@media (min-width: 640px) {
		.contact-page__footer {
			padding-inline: 2rem;
		}
	}

	@media (min-width: 1024px) {
		.contact-page__footer {
			padding-inline: 3.6rem;
		}
	}
</style>
