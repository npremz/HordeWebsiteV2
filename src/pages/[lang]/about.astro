---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import AboutPage from '../../components/about/AboutPage.astro';
import '../../components/home/home.css';
import { SUPPORTED_LOCALES, type Locale, useTranslations } from '../../i18n';

export const prerender = true;

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout lang={lang} title={t.aboutPage.title} description={t.aboutPage.description} pageType="AboutPage" headerVariant="light" bare>
  <script is:inline>document.documentElement.classList.add("home-js");</script>
  <article id="page-content" class="home-page about-page relative">
    <AboutPage lang={lang} />
  </article>
  <div slot="footer" class="about-page__footer">
    <Footer lang={lang} />
  </div>
</Layout>

<style>
  /* Mêmes marges que le footer global de la home et de la page contact. */
  .about-page__footer {
    padding-inline: 1rem;
    background: var(--color-bg);
    overflow-x: clip;
  }

  @media (min-width: 640px) {
    .about-page__footer {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .about-page__footer {
      padding-inline: 3.6rem;
    }
  }
</style>

<script>
  import { initHomeReveal } from '../../lib/home-reveal';
  import { pauseOffscreen } from '../../lib/pause-offscreen';

  initHomeReveal();
  pauseOffscreen();
  document.addEventListener('astro:page-load', () => {
    initHomeReveal();
    pauseOffscreen();
  });
</script>
