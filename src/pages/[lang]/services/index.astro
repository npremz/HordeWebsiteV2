---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import ServicesHub from '../../../components/services/hub/ServicesHub.astro';
import { SUPPORTED_LOCALES, type Locale, useTranslations } from '../../../i18n';
import { getServiceSummaries } from '../../../lib/content/services';

export const prerender = true;

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const pageCopy = t.servicesPage;
const siteUrl = (Astro.site?.href || 'https://hordeagence.com/').replace(/\/$/, '');
const pageUrl = `${siteUrl}/${lang}/services/`;
const serviceSummaries = (await getServiceSummaries(lang)).filter((service) =>
  service.seoRobots.startsWith('index'),
);
const servicesSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#services`,
      name: pageCopy.title,
      itemListElement: serviceSummaries.map((service, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: service.title,
        url: new URL(service.url, `${siteUrl}/`).href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: pageCopy.breadcrumbHome, item: `${siteUrl}/${lang}/` },
        { '@type': 'ListItem', position: 2, name: pageCopy.breadcrumbServices, item: pageUrl },
      ],
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />

<Layout lang={lang} title={pageCopy.title} description={pageCopy.description} headerVariant="dark" bare>
  <script is:inline>document.documentElement.classList.add("home-js");</script>
  <article id="page-content" class="home-page relative">
    <ServicesHub lang={lang} />
  </article>
  <div slot="footer" class="services-hub__footer">
    <Footer lang={lang} />
  </div>
</Layout>

<style>
  /* Mêmes marges que le footer de la home, de la page contact et des pages services v2. */
  .services-hub__footer {
    padding-inline: 1rem;
    background: var(--color-bg);
    overflow-x: clip;
  }

  @media (min-width: 640px) {
    .services-hub__footer {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .services-hub__footer {
      padding-inline: 3.6rem;
    }
  }
</style>
