---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import ServiceHero from '../../../components/services/ServiceHero.astro';
import ServiceOfferSection from '../../../components/services/ServiceOfferSection.astro';
import ServiceMethodSection from '../../../components/services/ServiceMethodSection.astro';
import ServiceDeliverablesSection from '../../../components/services/ServiceDeliverablesSection.astro';
import ServiceExclusionsSection from '../../../components/services/ServiceExclusionsSection.astro';
import ServiceFaqSection from '../../../components/services/ServiceFaqSection.astro';
import ServiceCtaSection from '../../../components/services/ServiceCtaSection.astro';
import { HTML_LOCALE_CODES, SUPPORTED_LOCALES, type Locale, useTranslations } from '../../../i18n';
import { type ServiceEntry, getServices, localizeServiceEntry } from '../../../lib/content/services';

export const prerender = true;

export async function getStaticPaths() {
  const services = await getServices();

  return SUPPORTED_LOCALES.flatMap((lang) =>
    services.map((service) => {
      const localizedService = localizeServiceEntry(service, lang);
      const seoUrlSegments = localizedService.data.seoUrl.split('/').filter(Boolean);
      const slug = seoUrlSegments[seoUrlSegments.length - 1] || service.data.slug;

      return {
        params: { lang, slug },
        props: { service, lang },
      };
    }),
  );
}

const { service, lang } = Astro.props as { service: ServiceEntry; lang: Locale };
const t = useTranslations(lang);
const localizedService = localizeServiceEntry(service, lang);
const switchLang: Locale = lang === 'fr' ? 'en' : 'fr';
const alternateUrl = localizeServiceEntry(service, switchLang).data.seoUrl;

const siteUrl = (Astro.site?.href || 'https://hordeagence.com/').replace(/\/$/, '');
const pageUrl = new URL(localizedService.data.seoUrl, `${siteUrl}/`).href;
const serviceName = (localizedService.data.shortName || localizedService.data.h1)
  .replace(/<br\s*\/?>/gi, ' ')
  .replace(/<[^>]+>/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: serviceName,
      ...(localizedService.data.shortName ? { serviceType: localizedService.data.shortName } : {}),
      description: localizedService.data.seoDescription,
      url: pageUrl,
      inLanguage: HTML_LOCALE_CODES[lang],
      provider: { '@id': `${siteUrl}#service` },
      brand: { '@id': `${siteUrl}#organization` },
      areaServed: [
        { '@type': 'City', name: lang === 'fr' ? 'Bruxelles' : 'Brussels' },
        { '@type': 'Country', name: lang === 'fr' ? 'Belgique' : 'Belgium' },
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: new URL(`/${lang}/contact/`, `${siteUrl}/`).href,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.servicesPage.breadcrumbHome, item: `${siteUrl}/${lang}/` },
        { '@type': 'ListItem', position: 2, name: t.servicesPage.breadcrumbServices, item: `${siteUrl}/${lang}/services/` },
        { '@type': 'ListItem', position: 3, name: serviceName, item: pageUrl },
      ],
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<Layout
  lang={lang}
  alternateUrl={alternateUrl}
  title={localizedService.data.seoTitle}
  description={localizedService.data.seoDescription}
  robots={localizedService.data.seoRobots as 'index, follow' | 'noindex, follow' | 'noindex, nofollow'}
  headerVariant="dark"
>
  <div class="fixed inset-0 bg-bg -z-10" aria-hidden="true"></div>
  <article data-service-slug={localizedService.data.slug}>
    <ServiceHero service={localizedService.data} />
    <ServiceOfferSection service={localizedService.data} />
    <ServiceMethodSection service={localizedService.data} />
    <ServiceDeliverablesSection service={localizedService.data} lang={lang} />
    <ServiceExclusionsSection service={localizedService.data} lang={lang} />
    <ServiceFaqSection service={localizedService.data} />
    <ServiceCtaSection service={localizedService.data} formTranslations={t.form} />
  </article>

  <Footer slot="footer" lang={lang} hideOverflow={false} />
</Layout>
